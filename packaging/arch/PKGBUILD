# Slipstream for Arch, through the AUR. Built from the source tarball each release carries, which
# holds every crate it needs, so it builds offline. packaging/prepare fills in the version.

pkgname=slipstream-desktop
_version=@VERSION@
pkgver=@ARCH_VERSION@
pkgrel=1
pkgdesc='Keyboard-first Wayland desktop session'
arch=('x86_64')
url='https://github.com/peterwalker78/slipstream-desktop'
license=('GPL-3.0-or-later' 'MIT' 'Apache-2.0' 'OFL-1.1')
depends=('gcc-libs' 'glibc' 'glib2' 'gtk4' 'pango' 'cairo' 'libdisplay-info' 'libdrm' 'libglvnd'
    'libinput' 'libxkbcommon' 'mesa' 'pam' 'seatd' 'systemd-libs')
makedepends=('cargo' 'clang' 'mold' 'pkgconf' 'pixman' 'wayland')
optdepends=('xorg-xwayland: X11 apps'
    'xdg-desktop-portal: dark apps, file dialogs, app shortcuts'
    'xdg-desktop-portal-wlr: screen sharing'
    'wireplumber: volume keys'
    'libpulse: sound muffled in bullet time'
    'pipewire: a click at the new volume'
    'networkmanager: Wi-Fi in quick settings'
    'bluez-utils: Bluetooth in quick settings'
    'power-profiles-daemon: power mode in quick settings'
    'bubblewrap: plugins')
backup=('etc/pam.d/slipstream' 'etc/xdg/xdg-desktop-portal-wlr/Slipstream')
options=('!lto' '!debug')
install=slipstream-desktop.install
source=("$url/releases/download/v$_version/$pkgname-$_version.tar.xz")
sha256sums=('@SHA256@')

build() {
    cd "$pkgname-$_version"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --locked --offline -p slipstream -p slipstream-settings -p slipstream-focus
}

package() {
    cd "$pkgname-$_version"
    sh packaging/install-files "$pkgdir" arch
}
