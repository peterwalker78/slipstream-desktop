[Unit]
Description=Slipstream session
Documentation=man:systemd.special(7)

# graphical-session.target goes active only when something binds to it, and every unit with
# Requisite=graphical-session.target refuses to start without it: the portal (no file pickers or
# screencasts for Flatpaks), Flatpak document sharing, GVfs and AT-SPI.
# BindsTo implies Requires for activation, and a dependency-driven start is exempt from
# graphical-session.target's RefuseManualStart=yes, which a plain `systemctl start` is not.
BindsTo=graphical-session.target
Before=graphical-session.target

Wants=graphical-session-pre.target
After=graphical-session-pre.target

# The autostart apps come up later, from slipstream-autostart.target, once X11 apps can connect.
