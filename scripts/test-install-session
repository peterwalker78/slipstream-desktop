#!/bin/sh
# Tests for install-session, run against a scratch folder standing in for the system's root and a
# scratch home, so nothing real is read for the checks that matter or written at all.
#
#   scripts/test-install-session          with sh
#   SHELL_UNDER_TEST=dash scripts/test-install-session
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd -P)
shell=${SHELL_UNDER_TEST:-sh}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0
passed=0

fail() {
    echo "FAIL: $*" >&2
    failures=$((failures + 1))
}
ok() { passed=$((passed + 1)); }

# A fresh system and home for each case.
fresh() {
    rm -rf "${work:?}/root" "${work:?}/home" "${work:?}/pam"
    mkdir -p "$work/root" "$work/home" "$work/pam"
    : >"$work/pam/password-auth"
    : >"$work/pam/system-auth"
    : >"$work/pam/login"
    printf 'ID=fedora\nPRETTY_NAME="Fedora Linux 44"\n' >"$work/os-release"
    # A machine with xdg-desktop-portal and Qt's portal platform theme, unless a case says
    # otherwise. Unset here because a variable set in front of a function call outlives it.
    unset XDP XDP_VERSION QT_DIRS
    mkdir -p "$work/qt/qt6/plugins/platformthemes"
    : >"$work/qt/qt6/plugins/platformthemes/libqxdgdesktopportal.so"
}

run() {
    env -u XDG_CURRENT_DESKTOP -u XDG_SESSION_DESKTOP -u XDG_CONFIG_HOME -u XDG_DATA_HOME \
        -u XDG_STATE_HOME -u SLIPSTREAM_TEST_FAIL_AT \
        HOME="$work/home" \
        SLIPSTREAM_TEST_ROOT="$work/root" \
        SLIPSTREAM_TEST_OS_RELEASE="$work/os-release" \
        SLIPSTREAM_TEST_PAM_DIR="$work/pam" \
        SLIPSTREAM_TEST_OSTREE="${OSTREE:-$work/not-atomic}" \
        SLIPSTREAM_TEST_DM="${DM-plasmalogin}" \
        SLIPSTREAM_TEST_SEAT=yes \
        SLIPSTREAM_TEST_XDP="${XDP-/usr/libexec/xdg-desktop-portal}" \
        SLIPSTREAM_TEST_XDP_VERSION="${XDP_VERSION-1.22.1}" \
        SLIPSTREAM_TEST_QT_DIRS="${QT_DIRS-$work/qt}" \
        ${FAIL_AT:+SLIPSTREAM_TEST_FAIL_AT=$FAIL_AT} \
        ${PORTAL_DIR:+SLIPSTREAM_TEST_PORTAL_DIR=$PORTAL_DIR} \
        ${XDPW:+SLIPSTREAM_TEST_XDPW_VERSION=$XDPW} \
        ${PKG_LOG:+SLIPSTREAM_TEST_PKG_LOG=$PKG_LOG} \
        "$shell" "${SCRIPT:-$repo/scripts/install-session}" "$@" >"$work/out" 2>&1
}

expect_status() {
    want=$1
    shift
    status=0
    run "$@" || status=$?
    if [ "$status" -ne "$want" ]; then
        fail "$case_name: exit $status, wanted $want"
        sed 's/^/    | /' "$work/out" >&2
        return 1
    fi
    ok
}

mode_of() { stat -c %a "$1"; }
r=$work/root
# The default case is Plasma Login on a writable /usr, where the entry goes in /usr/share.
entry=$r/usr/share/wayland-sessions/slipstream.desktop
launcher=$r/usr/local/bin/slipstream-session
pam=$r/etc/pam.d/slipstream
manifest=$r/usr/local/share/slipstream/installed
leftovers() { find "$r" -name '*.slipstream-new' | grep -q . ; }

case_name="installs everything, readable, with a manifest"
fresh
if expect_status 0; then
    for f in "$entry" "$launcher" "$pam" "$manifest"; do
        [ -f "$f" ] || fail "$case_name: $f missing"
    done
    [ "$(mode_of "$launcher")" = 755 ] || fail "$case_name: launcher mode $(mode_of "$launcher")"
    [ "$(mode_of "$entry")" = 644 ] || fail "$case_name: entry mode $(mode_of "$entry")"
    [ "$(mode_of "$r/usr/share/wayland-sessions")" = 755 ] || fail "$case_name: session folder mode"
    grep -q "auth       include      password-auth" "$pam" || fail "$case_name: PAM stack"
    [ "$(grep -c . "$manifest")" = 4 ] || fail "$case_name: manifest has $(grep -c . "$manifest") lines"
    leftovers && fail "$case_name: staged files left behind"
fi

case_name="installing again replaces its own files"
expect_status 0 || true

case_name="a tight umask still leaves files the login screen can read"
fresh
(umask 077 && expect_status 0) || fail "$case_name"
[ -f "$entry" ] && [ "$(mode_of "$entry")" = 644 ] || fail "$case_name: entry mode"
[ "$(mode_of "$r/etc/pam.d")" = 755 ] || fail "$case_name: pam.d mode $(mode_of "$r/etc/pam.d")"

case_name="--check writes nothing"
fresh
expect_status 0 --check || true
[ -z "$(find "$r" -type f)" ] || fail "$case_name: wrote $(find "$r" -type f)"

case_name="a PAM file someone else wrote is never replaced"
fresh
mkdir -p "$r/etc/pam.d"
echo "auth required pam_deny.so" >"$pam"
expect_status 1 || true
grep -q pam_deny "$pam" || fail "$case_name: PAM file changed"
[ -e "$entry" ] && fail "$case_name: wrote the session entry anyway"
grep -q "wasn't written by Slipstream" "$work/out" || fail "$case_name: no reason given"

case_name="a failure part way changes nothing"
fresh
FAIL_AT=3 expect_status 1 || true
[ -z "$(find "$r" -type f)" ] || fail "$case_name: left $(find "$r" -type f)"

case_name="a failed reinstall keeps the working install"
fresh
expect_status 0 || true
before=$(cat "$pam" "$entry" "$manifest" | cksum)
FAIL_AT=4 expect_status 1 || true
[ "$(cat "$pam" "$entry" "$manifest" | cksum)" = "$before" ] || fail "$case_name: files changed"
leftovers && fail "$case_name: staged files left behind"

case_name="moving to another display manager removes the old drop-in"
fresh
OSTREE=$work/os-release DM=lightdm expect_status 0 || true
dropin=$r/etc/lightdm/lightdm.conf.d/50-slipstream.conf
[ -f "$dropin" ] || fail "$case_name: no LightDM drop-in"
OSTREE=$work/os-release DM=plasmalogin expect_status 0 || true
[ -e "$dropin" ] && fail "$case_name: drop-in still there"
grep -q 50-slipstream "$manifest" && fail "$case_name: manifest still lists it"

case_name="Debian includes common-auth"
fresh
printf 'ID=debian\n' >"$work/os-release"
: >"$work/pam/common-auth"
: >"$work/pam/common-account"
DM=gdm expect_status 0 || true
grep -q "^@include common-auth" "$pam" || fail "$case_name: $(cat "$pam")"

case_name="no usable PAM stack refuses"
fresh
rm -f "$work/pam/"*
expect_status 1 || true
[ -z "$(find "$r" -type f)" ] || fail "$case_name: wrote files"

case_name="no display manager found still installs, with a note"
fresh
DM="" expect_status 0 || true
grep -q "No display manager was found" "$work/out" || fail "$case_name: no note"

case_name="SDDM on a writable /usr uses /usr/share, which 0.19 reads, and moves an older entry"
fresh
OSTREE=$work/os-release DM=sddm expect_status 0 || true
local_entry=$r/usr/local/share/wayland-sessions/slipstream.desktop
[ -f "$local_entry" ] || fail "$case_name: atomic install didn't use /usr/local"
DM=sddm expect_status 0 || true
[ -f "$entry" ] || fail "$case_name: no entry in /usr/share"
[ -e "$local_entry" ] && fail "$case_name: /usr/local entry still there"
grep -q "^/usr/share/wayland-sessions/slipstream.desktop$" "$manifest" || fail "$case_name: manifest"

case_name="SDDM's [Wayland] SessionDir is used, not [X11]'s, and sddm.conf wins over conf.d"
fresh
mkdir -p "$r/etc/sddm.conf.d"
printf '[Wayland]\nSessionDir=/opt/from-conf-d\n' >"$r/etc/sddm.conf.d/10-site.conf"
printf '[Wayland]\nSessionDir=/opt/wayland,/usr/share/wayland-sessions\n\n[X11]\nSessionDir=/opt/x11\n' \
    >"$r/etc/sddm.conf"
DM=sddm expect_status 0 || true
[ -f "$r/opt/wayland/slipstream.desktop" ] || fail "$case_name: $(grep 'session entry' "$work/out")"

case_name="GDM with Wayland turned off by its udev rules installs, and says why it won't be listed"
fresh
mkdir -p "$r/run/gdm3" "$r/etc/gdm3"
printf '[daemon]\n# Uncomment to force the login screen to use Xorg\n#WaylandEnable=false\n' >"$r/etc/gdm3/custom.conf"
printf '[daemon]\nWaylandEnable=false\n' >"$r/run/gdm3/custom.conf"
DM=gdm expect_status 0 || true
grep -q "turned Wayland off for this hardware" "$work/out" || fail "$case_name: no note"
grep -q "won't list it" "$work/out" || fail "$case_name: still claims it's listed"
[ -f "$local_entry" ] || fail "$case_name: no entry"

case_name="GDM with Wayland turned off in custom.conf names the file"
fresh
mkdir -p "$r/etc/gdm"
printf '[security]\nWaylandEnable=true\n[daemon]\nWaylandEnable=false\n' >"$r/etc/gdm/custom.conf"
DM=gdm expect_status 0 || true
grep -q "turned off in $r/etc/gdm/custom.conf" "$work/out" || fail "$case_name: no note"

case_name="GDM with a commented-out WaylandEnable says nothing about it"
fresh
mkdir -p "$r/etc/gdm3"
printf '[daemon]\n#WaylandEnable=false\n' >"$r/etc/gdm3/custom.conf"
DM=gdm expect_status 0 || true
grep -q "Wayland off\|Wayland turned off" "$work/out" && fail "$case_name: noted anyway"
grep -q "is on the login screen's session list" "$work/out" || fail "$case_name: no success line"

case_name="uninstall removes what it wrote, and only that"
fresh
expect_status 0 || true
mkdir -p "$work/home/.local/bin" "$work/home/.config/slipstream"
: >"$work/home/.local/bin/slipstream"
: >"$work/home/.config/slipstream/settings.toml"
echo "/etc/passwd" >>"$manifest"
mkdir -p "$r/etc"
echo "root:x:0:0" >"$r/etc/passwd"
expect_status 0 --uninstall --yes || true
for f in "$entry" "$launcher" "$pam" "$manifest" "$work/home/.local/bin/slipstream"; do
    [ -e "$f" ] && fail "$case_name: $f still there"
done
[ -d "$r/usr/local/share/slipstream" ] && fail "$case_name: manifest folder still there"
[ -e "$r/etc/passwd" ] || fail "$case_name: removed a file the manifest had no business listing"
[ -e "$work/home/.config/slipstream/settings.toml" ] || fail "$case_name: settings removed without --purge"

case_name="uninstall leaves a PAM file it didn't write"
fresh
mkdir -p "$r/etc/pam.d"
echo "auth required pam_deny.so" >"$pam"
expect_status 0 --uninstall --yes || true
[ -e "$pam" ] || fail "$case_name: removed it"

case_name="--purge removes settings too"
fresh
mkdir -p "$work/home/.config/slipstream" "$work/home/.local/state/slipstream"
expect_status 0 --uninstall --purge --yes || true
[ -d "$work/home/.config/slipstream" ] && fail "$case_name: settings still there"

case_name="uninstall asks, and no answer removes nothing"
fresh
expect_status 0 || true
status=0
run --uninstall </dev/null || status=$?
if [ "$status" = 1 ] && [ -e "$entry" ]; then
    ok
else
    fail "$case_name: exit $status"
fi

case_name="bad options"
fresh
expect_status 2 --frobnicate || true
expect_status 2 --purge || true

case_name="a copy in a folder with spaces"
fresh
mkdir -p "$work/copy with spaces/scripts" "$work/copy with spaces/session"
cp "$repo/scripts/install-session" "$work/copy with spaces/scripts/"
cp "$repo/session/slipstream-session" "$repo/session/slipstream.desktop" \
    "$repo/session/slipstream.portal" "$work/copy with spaces/session/"
SCRIPT="$work/copy with spaces/scripts/install-session" expect_status 0 || true
[ "$(cksum <"$entry")" = "$(cksum <"$repo/session/slipstream.desktop")" ] || fail "$case_name: entry differs"

case_name="an incomplete copy refuses"
fresh
rm "$work/copy with spaces/session/slipstream.desktop"
SCRIPT="$work/copy with spaces/scripts/install-session" expect_status 1 || true
[ -z "$(find "$r" -type f)" ] || fail "$case_name: wrote files"


# ---------------------------------------------------------------------------------------------
# A download carries the programs in bin/, and installs them for everyone on the machine.

download=$work/download
settings_entry_name=io.github.peterwalker78.SlipstreamSettings.desktop
make_download() {
    rm -rf "$download"
    mkdir -p "$download/bin" "$download/scripts" "$download/session" "$download/slipstream-settings"
    cp "$repo/scripts/install-session" "$download/scripts/"
    cp "$repo"/session/* "$download/session/"
    cp "$repo/slipstream-settings/$settings_entry_name" "$download/slipstream-settings/"
    printf '#!/bin/sh\necho "slipstream 9.9.9"\n' >"$download/bin/slipstream"
    printf '#!/bin/sh\n' >"$download/bin/slipstream-settings"
    chmod 755 "$download/bin/slipstream" "$download/bin/slipstream-settings"
}
# A machine with a screen-sharing backend new enough, and one desktop's backend beside it.
make_portals() {
    rm -rf "$work/portals"
    mkdir -p "$work/portals"
    for portal in "$@"; do
        : >"$work/portals/$portal.portal"
    done
}
installed_bin=$r/usr/local/bin/slipstream
installed_settings=$r/usr/local/bin/slipstream-settings
portals_conf=$r/usr/local/share/xdg-desktop-portal/slipstream-portals.conf
wlr_conf=$r/etc/xdg/xdg-desktop-portal-wlr/Slipstream
unit=$r/usr/local/lib/systemd/user/slipstream-session.target
portal_backend=$r/usr/local/share/xdg-desktop-portal/portals/slipstream.portal

case_name="a download installs the programs where everyone can run them"
fresh
make_download
make_portals wlr kde gtk
PORTAL_DIR=$work/portals XDPW=0.8.4 SCRIPT=$download/scripts/install-session \
    expect_status 0 --yes || true
[ "$(mode_of "$installed_bin")" = 755 ] || fail "$case_name: the program isn't installed 755"
[ -f "$installed_settings" ] || fail "$case_name: no Settings program"
[ -f "$r/usr/local/share/applications/$settings_entry_name" ] || fail "$case_name: no Settings entry"
[ -f "$unit" ] || fail "$case_name: no session unit"
grep -q "^default=kde;gtk$" "$portals_conf" || fail "$case_name: portals default is $(grep '^default' "$portals_conf")"
grep -q "^chooser_cmd=/usr/local/bin/slipstream --choose-share$" "$wlr_conf" \
    || fail "$case_name: the sharing picker isn't the installed program"
grep -q "^/usr/local/bin/slipstream$" "$manifest" || fail "$case_name: the manifest doesn't list the program"

case_name="a download installs the backend that tells apps dark or light"
fresh
make_download
make_portals wlr kde gtk
PORTAL_DIR=$work/portals XDPW=0.8.4 SCRIPT=$download/scripts/install-session \
    expect_status 0 --yes || true
grep -q "^DBusName=org.freedesktop.impl.portal.desktop.slipstream$" "$portal_backend" \
    || fail "$case_name: no settings portal backend at $portal_backend"
grep -q "^org.freedesktop.impl.portal.Settings=slipstream;\*$" "$portals_conf" \
    || fail "$case_name: Slipstream isn't asked about dark and light first"
grep -q "portals/slipstream.portal$" "$manifest" || fail "$case_name: not in the manifest"

case_name="Slipstream's own backend stays out of the list of the others"
fresh
make_download
make_portals wlr kde gtk slipstream
PORTAL_DIR=$work/portals XDPW=0.8.4 SCRIPT=$download/scripts/install-session \
    expect_status 0 --yes || true
grep -q "^default=kde;gtk$" "$portals_conf" || fail "$case_name: $(grep '^default' "$portals_conf")"

case_name="uninstalling a download takes the programs with it"
PORTAL_DIR=$work/portals SCRIPT=$download/scripts/install-session \
    expect_status 0 --uninstall --yes || true
for f in "$installed_bin" "$installed_settings" "$unit" "$portals_conf" "$portal_backend" \
    "$wlr_conf"; do
    if [ -e "$f" ]; then
        fail "$case_name: $f still there"
    fi
done

case_name="with no desktop backend installed, whatever turns up answers the rest"
fresh
make_download
make_portals wlr
PORTAL_DIR=$work/portals XDPW=0.8.4 SCRIPT=$download/scripts/install-session \
    expect_status 0 --yes || true
grep -q "^default=\*$" "$portals_conf" || fail "$case_name: $(grep '^default' "$portals_conf")"

case_name="an old screen-sharing portal is explained, not installed over"
fresh
make_download
make_portals wlr gtk
PORTAL_DIR=$work/portals XDPW=0.7.1 PKG_LOG=$work/packages \
    SCRIPT=$download/scripts/install-session expect_status 0 --yes || true
grep -q "0.8 or newer" "$work/out" || fail "$case_name: nothing said about the version"
if [ -e "$work/packages" ] && grep -q xdg-desktop-portal-wlr "$work/packages"; then
    fail "$case_name: installed a package that wouldn't have helped"
fi

case_name="no portal at all is offered as a package"
fresh
make_download
make_portals wlr gtk
rm -f "$work/packages"
XDP='' PORTAL_DIR=$work/portals XDPW=0.8.4 PKG_LOG=$work/packages \
    SCRIPT=$download/scripts/install-session expect_status 0 --yes || true
grep -qE ' xdg-desktop-portal( |$)' "$work/packages" \
    || fail "$case_name: $(cat "$work/packages" 2>/dev/null)"

case_name="a portal too old to find the backend is explained, not installed over"
fresh
make_download
make_portals wlr gtk
rm -f "$work/packages"
XDP_VERSION=1.16.0 PORTAL_DIR=$work/portals XDPW=0.8.4 PKG_LOG=$work/packages \
    SCRIPT=$download/scripts/install-session expect_status 0 --yes || true
grep -q "1.17 or newer" "$work/out" || fail "$case_name: nothing said about the portal's version"
if [ -e "$work/packages" ] && grep -qE ' xdg-desktop-portal( |$)' "$work/packages"; then
    fail "$case_name: installed a package that wouldn't have helped"
fi

case_name="Qt without the portal's platform theme is said so"
fresh
make_download
make_portals wlr gtk
mkdir -p "$work/no-qt"
QT_DIRS=$work/no-qt PORTAL_DIR=$work/portals XDPW=0.8.4 \
    SCRIPT=$download/scripts/install-session expect_status 0 --yes || true
grep -q "dark and light in Qt apps" "$work/out" || fail "$case_name: nothing said about Qt"

case_name="a machine that logs in by itself is told how to reach the session list"
fresh
mkdir -p "$r/etc/sddm.conf.d"
printf '[Autologin]\nUser=sam\nSession=hyprland.desktop\n' >"$r/etc/sddm.conf.d/00-autologin.conf"
DM=sddm expect_status 0 || true
grep -q "logs in automatically" "$work/out" || fail "$case_name: autologin not noticed"
grep -q "sam, straight into hyprland.desktop" "$work/out" || fail "$case_name: $(grep -i autologin "$work/out")"

case_name="an automatic login for a system account isn't reported as one"
fresh
mkdir -p "$r/etc/sddm.conf.d"
printf '[Autologin]\nUser=root\nSession=plasma.desktop\n' >"$r/etc/sddm.conf.d/00-setup.conf"
DM=sddm expect_status 0 || true
grep -q "logs in automatically" "$work/out" && fail "$case_name: reported a setup account's stanza"

case_name="missing packages are installed when told to"
fresh
make_download
make_portals gtk
rm -f "$work/packages"
PORTAL_DIR=$work/portals PKG_LOG=$work/packages SCRIPT=$download/scripts/install-session \
    expect_status 0 --yes || true
grep -q "^sudo dnf install -y .*xdg-desktop-portal-wlr" "$work/packages" \
    || fail "$case_name: $(cat "$work/packages" 2>/dev/null)"

case_name="nothing is installed without being asked when there's no terminal"
fresh
make_download
make_portals gtk
rm -f "$work/packages"
status=0
PORTAL_DIR=$work/portals PKG_LOG=$work/packages SCRIPT=$download/scripts/install-session \
    run </dev/null || status=$?
[ "$status" = 0 ] || fail "$case_name: exit $status"
if [ -s "$work/packages" ]; then
    fail "$case_name: installed packages anyway: $(cat "$work/packages")"
fi
[ -f "$installed_bin" ] || fail "$case_name: didn't install the files it could"

echo "install-session ($shell): $passed checks passed, $failures failed"
[ "$failures" -eq 0 ]
