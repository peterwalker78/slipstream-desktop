#!/bin/sh
# Puts Slipstream on the login screen's session list, having first found out what it is
# installing onto, or takes it off again.
#
#   scripts/install-session             check the system, then install (asks for sudo)
#   scripts/install-session --check     check only; writes nothing
#   scripts/install-session --uninstall [--purge] [--yes]
#
# Run it as yourself, not with sudo: it needs to know whose desktop this is, and asks for root
# only for the files outside your home. Everything is checked before anything is written, and the
# files are written all or nothing, so a refusal or a failure leaves the system as it was.
#
# Run from an unpacked download, it installs the programs too, in /usr/local, where everyone with
# an account on the machine can use them. It offers to install missing packages with this system's
# own package manager, and never installs anything without being told to.
#
# In a source checkout there are no programs to install: scripts/update-session builds them into
# your own home, which is also how to keep a build of your own alongside an installed release.
set -eu
# Files written as root have to be readable by the login screen, whatever umask you keep.
umask 022

repo=$(cd "$(dirname "$0")/.." && pwd -P)

# An unpacked download carries the programs ready-built in bin/; a source checkout doesn't.
programs=
if [ -x "$repo/bin/slipstream" ] && [ -x "$repo/bin/slipstream-settings" ]; then
    programs=$repo/bin
fi

# Tests: SLIPSTREAM_TEST_ROOT puts every system file under a folder and writes them without sudo;
# the other SLIPSTREAM_TEST_ variables stand in for what the system would say about itself.
root=${SLIPSTREAM_TEST_ROOT:-}
os_release=${SLIPSTREAM_TEST_OS_RELEASE:-/etc/os-release}
[ -r "$os_release" ] || os_release=/usr/lib/os-release
manifest_dir=/usr/local/share/slipstream
manifest=$manifest_dir/installed
# Where portal backends say what they implement. Tests point this at a folder of their own.
portal_dirs=${SLIPSTREAM_TEST_PORTAL_DIR:-/usr/share/xdg-desktop-portal/portals /usr/local/share/xdg-desktop-portal/portals}

mode=install
purge=no
assume_yes=no
for arg in "$@"; do
    case $arg in
        --check) mode=check ;;
        --uninstall) mode=uninstall ;;
        --purge) purge=yes ;;
        --yes | -y) assume_yes=yes ;;
        -h | --help)
            sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "install-session: unknown option $arg (try --help)" >&2
            exit 2
            ;;
    esac
done
if [ "$purge" = yes ] && [ "$mode" != uninstall ]; then
    echo "install-session: --purge only goes with --uninstall" >&2
    exit 2
fi

if [ "$(id -u)" -eq 0 ] && [ -z "$root" ]; then
    echo "install-session: run this as your own user, not as root." >&2
    echo "It asks for sudo itself, for the few files outside your home." >&2
    exit 2
fi
if [ -z "${HOME:-}" ] || ! [ -d "$HOME" ]; then
    echo "install-session: HOME isn't set to a folder, so there's no telling whose desktop this is." >&2
    exit 2
fi

bold() {
    if [ -t 1 ]; then
        printf '\033[1m%s\033[0m\n' "$*"
    else
        printf '%s\n' "$*"
    fi
}
say() { printf '  %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------------------------
# What system is this?

field() { sed -n "s/^$1=//p" "$os_release" 2>/dev/null | head -n1 | tr -d "\"'"; }
os_id=$(field ID)
os_like=$(field ID_LIKE)
os_name=$(field PRETTY_NAME)
[ -n "$os_name" ] || os_name=${os_id:-an unknown system}

family=unknown
for id in $os_id $os_like; do
    case $id in
        fedora | rhel | centos) family=fedora; break ;;
        debian | ubuntu) family=debian; break ;;
        arch | archlinux) family=arch; break ;;
        suse | opensuse | opensuse-tumbleweed | opensuse-leap) family=suse; break ;;
        nixos) family=nixos; break ;;
    esac
done

atomic=no
if [ -e "${SLIPSTREAM_TEST_OSTREE:-/run/ostree-booted}" ]; then
    atomic=yes
fi

# Where PAM looks for the stacks the lock's service includes. Tests point it at a folder of their own.
pam_dirs=${SLIPSTREAM_TEST_PAM_DIR:-/etc/pam.d /usr/lib/pam.d}
pam_file=/etc/pam.d/slipstream
pam_marker="# Written by Slipstream's install-session"

pam_has() {
    for dir in $pam_dirs; do
        [ -e "$dir/$1" ] && return 0
    done
    return 1
}

# The lock screen checks the password through a PAM service of its own, which includes the stack
# this system's own logins use for a password: password-auth on Fedora and its relatives (no
# fingerprint prompt), common-auth on Debian and openSUSE, system-auth on Arch, and login where
# none of those is there. The first whose stacks all exist is used.
pam_auth=
pam_account=
pam_stacks=
case $family in
    fedora) candidates="include:password-auth include:system-auth include:login" ;;
    debian) candidates="@include:common-auth include:login" ;;
    suse) candidates="include:common-auth include:login" ;;
    arch) candidates="include:system-auth include:system-login include:login" ;;
    *) candidates="include:login include:system-auth include:common-auth" ;;
esac
for candidate in $candidates; do
    syntax=${candidate%%:*}
    auth_stack=${candidate#*:}
    account_stack=$auth_stack
    [ "$auth_stack" = common-auth ] && account_stack=common-account
    if pam_has "$auth_stack" && pam_has "$account_stack"; then
        if [ "$syntax" = @include ]; then
            pam_auth="@include $auth_stack"
            pam_account="@include $account_stack"
        else
            pam_auth="auth       include      $auth_stack"
            pam_account="account    include      $account_stack"
        fi
        pam_stacks="$auth_stack $account_stack"
        break
    fi
done

# The display manager, by the unit systemd starts for it, else by what is running. With no
# display-manager.service, systemctl answers with the name it was asked about.
dm=${SLIPSTREAM_TEST_DM-}
if [ -z "${SLIPSTREAM_TEST_DM+set}" ]; then
    if have systemctl; then
        dm=$(systemctl show -p Id --value display-manager.service 2>/dev/null || true)
        dm=${dm%.service}
        [ "$dm" = display-manager ] && dm=
    fi
    if [ -z "$dm" ] && have pgrep; then
        for name in plasmalogin sddm gdm gdm3 lightdm greetd ly cosmic-greeter; do
            if pgrep -x "$name" >/dev/null 2>&1; then
                dm=$name
                break
            fi
        done
    fi
fi
case $dm in
    gdm3) dm=gdm ;;
    ly-dm | ly@*) dm=ly ;;
esac

# `ini_value SECTION KEY FILE...`: the value of the last `Key=` line inside [SECTION] (anywhere, when
# SECTION is empty) across the files, later files winning.
ini_value() {
    iv_section=$1
    iv_key=$2
    shift 2
    for iv_file in "$@"; do
        [ -r "$iv_file" ] || continue
        awk -v section="$iv_section" -v key="$iv_key" '
            /^[[:space:]]*\[/ {
                current = $0
                gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", current)
                next
            }
            (section == "" || current == section) && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
                value = $0
                sub(/^[^=]*=[[:space:]]*/, "", value)
                sub(/[[:space:]]+$/, "", value)
                last = value
            }
            END { if (last != "") print last }' "$iv_file"
    done | tail -n1
}

# The first directory in a `Key=a,b` line of a display manager's config files, if one is set.
config_dir() {
    ini_value "$@" | tr ',:' '\n' | head -n1
}

# The file in which GDM last turns Wayland off, if it does. The runtime file, which GDM's udev rules
# write for hardware its Wayland greeter can't use, overrides custom.conf. gdm3 is Debian's name.
gdm_wayland_off() {
    gwo_found=
    for gwo_file in "$root"/etc/gdm3/custom.conf "$root"/etc/gdm/custom.conf \
        "$root"/run/gdm3/custom.conf "$root"/run/gdm/custom.conf; do
        case $(ini_value daemon WaylandEnable "$gwo_file") in
            false | False | FALSE | 0) gwo_found=$gwo_file ;;
            true | True | TRUE | 1) gwo_found= ;;
        esac
    done
    if [ -n "$gwo_found" ]; then
        printf '%s\n' "$gwo_found"
    fi
}

# Where that display manager looks for Wayland sessions. `/usr/local/share/wayland-sessions`
# being right on this laptop is a fact about SDDM and its Plasma Login fork, not about Linux.
session_dir=
session_note=
lightdm_dropin=
wayland_off=
case $dm in
    sddm | plasmalogin)
        # A [Wayland] SessionDir in its config wins; sddm.conf is read after the conf.d files.
        # Otherwise every version reads /usr/share/wayland-sessions, but only 0.20 and later also
        # read /usr/local (0.19 is still Ubuntu 22.04's and Debian 12's), so /usr/local is used
        # only where /usr can't be written, and SDDM there is new enough.
        set -- "$root"/usr/lib/"$dm"/"$dm".conf.d/*.conf "$root"/etc/"$dm".conf.d/*.conf "$root"/etc/"$dm".conf
        configured=$(config_dir Wayland SessionDir "$@")
        if [ -n "$configured" ]; then
            session_dir=$configured
        elif [ "$atomic" = yes ]; then
            session_dir=/usr/local/share/wayland-sessions
        else
            session_dir=/usr/share/wayland-sessions
        fi
        ;;
    gdm | cosmic-greeter)
        # Both read wayland-sessions under every XDG data directory, /usr/local/share first.
        session_dir=/usr/local/share/wayland-sessions
        # GDM leaves Wayland sessions off its list altogether while its own Wayland is turned off.
        if [ "$dm" = gdm ]; then
            wayland_off=$(gdm_wayland_off)
            case $wayland_off in
                "$root"/run/*)
                    session_note="GDM has turned Wayland off for this hardware ($wayland_off), and
  while it's off it lists no Wayland session, Slipstream included. It does that for NVIDIA's
  driver without nvidia-drm.modeset=1 on the kernel command line, for nomodeset, and for some
  virtual machines' graphics. Once GDM runs on Wayland, Slipstream is on the list."
                    ;;
                ?*)
                    session_note="GDM has Wayland turned off in $wayland_off (WaylandEnable=false), and
  while it's off it lists no Wayland session, Slipstream included. Remove that line and restart
  GDM (or reboot) for Slipstream to be on the list."
                    ;;
            esac
        fi
        ;;
    lightdm)
        # LightDM's sessions-directory doesn't include /usr/local. On a writable /usr the file
        # goes beside the other sessions; on an atomic system a drop-in adds /usr/local instead.
        if [ "$atomic" = yes ]; then
            session_dir=/usr/local/share/wayland-sessions
            lightdm_dropin=/etc/lightdm/lightdm.conf.d/50-slipstream.conf
        else
            session_dir=/usr/share/wayland-sessions
        fi
        ;;
    ly)
        configured=$(config_dir "" waylandsessions "$root"/etc/ly/config.ini)
        session_dir=${configured:-/usr/share/wayland-sessions}
        ;;
    greetd)
        # greetd has no session list; its greeter does. tuigreet and ReGreet both default to
        # /usr/share/wayland-sessions.
        if [ "$atomic" = yes ]; then
            session_dir=/usr/local/share/wayland-sessions
            session_note="greetd's greeter has to be told about it: for tuigreet, add
    --sessions /usr/local/share/wayland-sessions:/usr/share/wayland-sessions
  to the command in /etc/greetd/config.toml."
        else
            session_dir=/usr/share/wayland-sessions
        fi
        ;;
    "")
        session_dir=/usr/local/share/wayland-sessions
        session_note="No display manager was found, so this is a guess. Without one, start it from a
  text console with: slipstream --session"
        ;;
    *)
        session_dir=/usr/local/share/wayland-sessions
        session_note="$dm isn't one this script knows, so $session_dir is a guess. If Slipstream isn't
  on the login screen afterwards, copy the .desktop file to where $dm reads sessions."
        ;;
esac

# Every file this script may write, as root. The manifest lists what an install actually wrote;
# nothing outside this list is ever removed, whatever a manifest says.
session_launcher=/usr/local/bin/slipstream-session
session_entry=$session_dir/slipstream.desktop
# The programs and the per-session files that go with them, for everyone on the machine. A user
# manager reads units from /usr/local/lib/systemd/user, and the portal reads its configuration
# from /usr/local/share and /etc/xdg, so none of this needs a copy in anybody's home.
installed_bin=/usr/local/bin/slipstream
installed_settings=/usr/local/bin/slipstream-settings
settings_entry_name=io.github.peterwalker78.SlipstreamSettings.desktop
settings_entry=/usr/local/share/applications/$settings_entry_name
session_target=/usr/local/lib/systemd/user/slipstream-session.target
shutdown_target=/usr/local/lib/systemd/user/slipstream-shutdown.target
portals_conf=/usr/local/share/xdg-desktop-portal/slipstream-portals.conf
wlr_conf=/etc/xdg/xdg-desktop-portal-wlr/Slipstream

ours() {
    case $1 in
        "$session_launcher" | */wayland-sessions/slipstream.desktop | "$pam_file" \
            | /etc/lightdm/lightdm.conf.d/50-slipstream.conf | "$manifest" \
            | "$installed_bin" | "$installed_settings" | "$settings_entry" \
            | "$session_target" | "$shutdown_target" \
            | "$portals_conf" | "$wlr_conf") return 0 ;;
    esac
    return 1
}

# Whether an existing file at a path this script writes came from Slipstream, so it may be
# replaced or removed. A file someone else put there is left alone.
# POSIX sh has no local variables, so its own are named to stay out of callers' way.
written_by_slipstream() {
    wbs_file=$root$1
    [ -e "$wbs_file" ] || return 0
    case $1 in
        "$session_launcher") grep -q "Starts Slipstream as a login session" "$wbs_file" 2>/dev/null ;;
        */slipstream.desktop) grep -q "^Exec=/usr/local/bin/slipstream-session" "$wbs_file" 2>/dev/null ;;
        "$pam_file" | */50-slipstream.conf) grep -qF "$pam_marker" "$wbs_file" 2>/dev/null ;;
        *) return 0 ;;
    esac
}

# ---------------------------------------------------------------------------------------------
# What it needs.

# Package names per family, for the one line that tells you how to get what's missing.
package() {
    case $1:$family in
        xwayland:fedora) echo xorg-x11-server-Xwayland ;;
        xwayland:debian | xwayland:suse) echo xwayland ;;
        xwayland:arch) echo xorg-xwayland ;;
        portal:*) echo xdg-desktop-portal ;;
        portal-wlr:*) echo xdg-desktop-portal-wlr ;;
        wpctl:*) echo wireplumber ;;
        pactl:arch) echo libpulse ;;
        pactl:*) echo pulseaudio-utils ;;
        pw-play:debian) echo pipewire-bin ;;
        pw-play:arch) echo pipewire ;;
        pw-play:suse) echo pipewire-tools ;;
        pw-play:*) echo pipewire-utils ;;
        nmcli:debian) echo network-manager ;;
        nmcli:arch) echo networkmanager ;;
        nmcli:*) echo NetworkManager ;;
        bluetoothctl:arch) echo bluez-utils ;;
        bluetoothctl:*) echo bluez ;;
        power-profiles:*) echo power-profiles-daemon ;;
        terminal:*) echo foot ;;
    esac
}

install_command() {
    case $family:$atomic in
        fedora:yes) echo "rpm-ostree install $* && systemctl reboot" ;;
        fedora:no) echo "sudo dnf install $*" ;;
        debian:*) echo "sudo apt install $*" ;;
        arch:*) echo "sudo pacman -S $*" ;;
        suse:yes) echo "sudo transactional-update pkg install $* && sudo reboot" ;;
        suse:no) echo "sudo zypper install $*" ;;
        *) echo "install with your package manager: $*" ;;
    esac
}

# The same command without questions, for when this script installs the packages itself. Empty
# where it won't: on atomic systems, where installing rewrites the system image and wants a
# reboot, and on families whose package manager this script doesn't know.
install_now_command() {
    case $family:$atomic in
        fedora:no) echo "sudo dnf install -y" ;;
        debian:*) echo "sudo apt-get install -y" ;;
        arch:*) echo "sudo pacman -S --needed --noconfirm" ;;
        suse:no) echo "sudo zypper --non-interactive install" ;;
        *) echo "" ;;
    esac
}

# `install_packages PACKAGE...`, once you've been asked. Tests point SLIPSTREAM_TEST_PKG_LOG at a
# file and nothing is really installed.
install_packages() {
    ip_command=$(install_now_command)
    if [ -z "$ip_command" ]; then
        return 1
    fi
    if [ -n "${SLIPSTREAM_TEST_PKG_LOG:-}" ]; then
        printf '%s %s\n' "$ip_command" "$*" >>"$SLIPSTREAM_TEST_PKG_LOG"
        return 0
    fi
    # A run against a scratch root is pretending to be another system; installing real packages
    # on this one would be a surprise.
    if [ -n "$root" ]; then
        return 1
    fi
    # Debian's package lists can be older than the packages on the mirrors, and apt then refuses
    # to fetch anything at all.
    if [ "$family" = debian ]; then
        sudo apt-get update || return 1
    fi
    # shellcheck disable=SC2086 # the command is several words
    $ip_command "$@"
}

# Which package carries a shared library, per family. Everything the Settings app needs beyond
# GTK comes with GTK itself.
library_package() {
    case $1 in
        libseat.so.1) echo "libseat libseat1 seatd libseat1" ;;
        libinput.so.10) echo "libinput libinput10 libinput libinput10" ;;
        libxkbcommon.so.0) echo "libxkbcommon libxkbcommon0 libxkbcommon libxkbcommon0" ;;
        libgbm.so.1) echo "mesa-libgbm libgbm1 mesa libgbm1" ;;
        libudev.so.1) echo "systemd-libs libudev1 systemd-libs libudev1" ;;
        libdrm.so.2) echo "libdrm libdrm2 libdrm libdrm2" ;;
        libEGL.so.1) echo "libglvnd-egl libegl1 libglvnd libglvnd" ;;
        libgtk-4.so.1 | libpango* | libcairo* | libgdk_pixbuf* | libgraphene* | libgio* \
            | libgobject* | libglib* | libgmodule* | libharfbuzz* | libepoxy*)
            echo "gtk4 libgtk-4-1 gtk4 libgtk-4-1"
            ;;
        *) echo "" ;;
    esac | awk -v family="$family" '{
        if (family == "fedora") print $1;
        else if (family == "debian") print $2;
        else if (family == "arch") print $3;
        else if (family == "suse") print $4;
    }'
}

# The libraries the programs to be installed can't find here, one per line.
missing_libraries() {
    for ml_program in "$@"; do
        ldd "$ml_program" 2>/dev/null | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p'
    done | sed '/^$/d' | sort -u
}

# What version of xdg-desktop-portal-wlr is installed, if this system can say.
xdpw_version() {
    if [ -n "${SLIPSTREAM_TEST_XDPW_VERSION+set}" ]; then
        printf '%s\n' "$SLIPSTREAM_TEST_XDPW_VERSION"
        return 0
    fi
    if have rpm; then
        rpm -q --qf '%{VERSION}\n' xdg-desktop-portal-wlr 2>/dev/null | head -n1
    elif have dpkg-query; then
        dpkg-query -W -f '${Version}\n' xdg-desktop-portal-wlr 2>/dev/null \
            | head -n1 | sed 's/^[0-9]*://; s/[-+].*//'
    elif have pacman; then
        pacman -Q xdg-desktop-portal-wlr 2>/dev/null | awk '{ print $2 }' | sed 's/-[0-9]*$//'
    fi
}

# `at_least WANT HAVE`: true when version HAVE is WANT or newer.
at_least() {
    [ -n "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}

# Whether this system logs someone straight in, and how to get a session list back. Screen sharing
# and the session entry are both useless if the login screen never appears.
autologin=
autologin_note=

# Whether an automatic login is for a person rather than one of the system accounts a first-boot
# wizard leaves behind, whose stanza sits in the configuration long after it has stopped running.
# A name this machine doesn't know is taken at face value: it may be a person elsewhere.
real_person() {
    rp_uid=$(id -u "$1" 2>/dev/null) || return 0
    if [ -z "$rp_uid" ]; then
        return 0
    fi
    [ "$rp_uid" -ge 1000 ]
}
find_autologin() {
    case $dm in
        sddm | plasmalogin)
            set -- "$root"/usr/lib/"$dm"/"$dm".conf.d/*.conf "$root"/etc/"$dm".conf.d/*.conf \
                "$root"/etc/"$dm".conf
            fa_user=$(ini_value Autologin User "$@")
            fa_session=$(ini_value Autologin Session "$@")
            if [ -n "$fa_user" ] && real_person "$fa_user"; then
                autologin="$fa_user, straight into ${fa_session:-its default session}"
                autologin_note="Set Session=slipstream.desktop in $dm's [Autologin] section to log
    straight into Slipstream instead, or remove the [Autologin] section to get the list back."
            fi
            ;;
        gdm)
            fa_files="$root/etc/gdm3/custom.conf $root/etc/gdm/custom.conf"
            # shellcheck disable=SC2086 # one file per word
            case $(ini_value daemon AutomaticLoginEnable $fa_files) in
                true | True | TRUE | 1)
                    # shellcheck disable=SC2086 # one file per word
                    fa_user=$(ini_value daemon AutomaticLogin $fa_files)
                    if [ -n "$fa_user" ] && ! real_person "$fa_user"; then
                        fa_user=
                    fi
                    autologin="${fa_user:+$fa_user, }straight into their last session"
                    autologin_note="Remove AutomaticLoginEnable from GDM's custom.conf to get the
    login screen back, then pick Slipstream there."
                    ;;
            esac
            ;;
        lightdm)
            fa_user=$(ini_value "" autologin-user "$root"/etc/lightdm/lightdm.conf \
                "$root"/etc/lightdm/lightdm.conf.d/*.conf)
            if [ -n "$fa_user" ] && real_person "$fa_user"; then
                fa_session=$(ini_value "" autologin-session "$root"/etc/lightdm/lightdm.conf \
                    "$root"/etc/lightdm/lightdm.conf.d/*.conf)
                autologin="$fa_user, straight into ${fa_session:-its default session}"
                autologin_note="Set autologin-session=slipstream in LightDM's configuration to log
    straight into Slipstream, or remove autologin-user to get the list back."
            fi
            ;;
        greetd)
            if grep -q '^[[:space:]]*\[initial_session\]' "$root"/etc/greetd/config.toml 2>/dev/null; then
                autologin="someone, through greetd's initial_session"
                autologin_note="Point greetd's [initial_session] command at 'slipstream --session',
    or remove that section to be asked at every boot."
            fi
            ;;
    esac
}

limits=""
problems=""
problem() { problems="$problems
  - $*"; }
missing=""
missing_packages=""
# Things without which nothing would start at all, kept apart from the optional ones because a
# refusal to install these has to stop the installation.
required=""
required_packages=""
needs() {
    required="$required
  - $2"
    case " $required_packages " in
        *" $1 "*) ;;
        *) required_packages="$required_packages $1" ;;
    esac
}
lacks() {
    missing="$missing
  - $2"
    pkg=$(package "$1")
    case " $missing_packages " in
        *" $pkg "*) ;;
        *) missing_packages="$missing_packages $pkg" ;;
    esac
}

check() {
    if [ "$family" = nixos ]; then
        problem "NixOS: a script that writes into /usr is the wrong shape here. Slipstream would
    need a NixOS module (services.displayManager.sessionPackages), which doesn't exist yet."
    fi
    for file in session/slipstream-session session/slipstream.desktop; do
        if ! [ -r "$repo/$file" ]; then
            problem "$repo/$file is missing: run this from a complete copy of Slipstream."
        fi
    done
    for tool in install mktemp sed grep; do
        have "$tool" || problem "$tool isn't installed, and this script needs it."
    done
    # A seat manager, without which the hardware backend can't open the screen or the input
    # devices at all.
    if [ -n "${SLIPSTREAM_TEST_SEAT:-}" ] || [ -d /run/systemd/seats ] || [ -S /run/seatd.sock ] \
        || have seatd; then
        :
    else
        problem "no seat manager: neither logind nor seatd is running, so Slipstream couldn't take
    the screen and keyboard. Install and enable seatd, or use a systemd-based system."
    fi
    if [ -z "$root" ] && ! have sudo; then
        problem "sudo isn't installed, and the session's entry has to go outside your home."
    fi
    # Where the session file goes has to be writable (as root). /usr on an atomic system isn't.
    case $session_dir in
        /usr/local/*) ;;
        /usr/*)
            if [ "$atomic" = yes ]; then
                problem "$dm reads sessions from $session_dir, which is read-only on $os_name.
    Point $dm at /usr/local/share/wayland-sessions in its configuration, then run this again."
            fi
            ;;
    esac
    case $session_dir in
        /*) ;;
        *) problem "$dm's configured session folder, '$session_dir', isn't an absolute path." ;;
    esac

    # The lock's PAM service includes this system's password stack. Without it PAM falls back to
    # refusing everyone, and the right password would read as wrong for ever.
    if [ -z "$pam_stacks" ]; then
        problem "none of the PAM stacks the lock screen could use ($candidates) is in
    $pam_dirs. Slipstream's lock would refuse every password here."
    fi

    # Files already where this script writes that something else put there are never replaced.
    for path in "$session_launcher" "$session_entry" "$pam_file" $lightdm_dropin; do
        if ! written_by_slipstream "$path"; then
            problem "$root$path already exists and wasn't written by Slipstream; move it away
    if it's not needed, then run this again."
        fi
    done

    # The programs about to be installed have to be able to start here: every library they link,
    # and libEGL, which they open by name at run time rather than link.
    if [ -n "$programs" ] && have ldd; then
        for library in $(missing_libraries "$programs/slipstream" "$programs/slipstream-settings"); do
            package=$(library_package "$library")
            if [ -n "$package" ]; then
                needs "$package" "$library, which Slipstream can't start without ($package)"
            else
                problem "no package here provides $library, which Slipstream needs. This system
    may be too old for this download; building from source would work."
            fi
        done
    fi
    if have ldconfig && ! ldconfig -p 2>/dev/null | grep -q 'libEGL\.so\.1'; then
        egl=$(library_package libEGL.so.1)
        if [ -n "$egl" ]; then
            needs "$egl" "libEGL: nothing can be drawn on the screen ($egl)"
        fi
    fi

    # What individual features need. None of these stops the session working.
    have Xwayland || lacks xwayland "Xwayland: X11 apps (Steam, older games) won't open"
    if ! portal_backend_installed wlr; then
        lacks portal-wlr "xdg-desktop-portal-wlr: no screen sharing (Discord, Meet, OBS)"
    elif ! at_least 0.8 "$(xdpw_version)"; then
        # Screen sharing is done through protocols the portal only learned to speak in 0.8.0
        # (October 2025). Older ones ask for a protocol Slipstream doesn't serve, and sharing
        # fails with no useful message; installing them wouldn't help.
        limits="$limits
  - screen sharing: this system's xdg-desktop-portal-wlr is $(xdpw_version), and 0.8 or newer is
    needed. Everything else works. A newer release of $os_name will have it."
    fi
    have wpctl || lacks wpctl "wpctl: the volume keys, the on-screen display and the tray's volume"
    have pactl || lacks pactl "pactl: bullet time can't muffle the sound"
    have pw-play || lacks pw-play "pw-play: no click at the new volume"
    have nmcli || lacks nmcli "nmcli: quick settings' Wi-Fi tile does nothing"
    have bluetoothctl || lacks bluetoothctl "bluetoothctl: quick settings' Bluetooth tile does nothing"
    if have busctl && ! busctl --system status org.freedesktop.UPower.PowerProfiles >/dev/null 2>&1 \
        && ! busctl --system status net.hadess.PowerProfiles >/dev/null 2>&1; then
        lacks power-profiles "power-profiles-daemon: quick settings' Power mode tile does nothing"
    fi
    terminal=no
    for t in ghostty konsole ptyxis gnome-terminal foot alacritty kitty wezterm xterm; do
        if have "$t"; then
            terminal=yes
            break
        fi
    done
    [ "$terminal" = yes ] || lacks terminal "a terminal: Super+Return opens nothing"
    find_autologin

    # The compositor itself, once installed: every library it links has to be here.
    bin="$HOME/.local/bin/slipstream"
    if [ -x "$bin" ] && have ldd; then
        libs=$(ldd "$bin" 2>&1 | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p' | tr '\n' ' ')
        if [ -n "$libs" ]; then
            problem "the installed compositor can't start: missing libraries $libs"
        fi
    fi
}

report() {
    bold "Slipstream on $os_name"
    say "family: $family$([ "$atomic" = yes ] && echo ', atomic (/usr is read-only)')"
    say "display manager: ${dm:-none found}"
    if [ -n "$programs" ]; then
        say "programs: $root$installed_bin and $root$installed_settings, for everyone here"
    else
        say "programs: none in this folder; scripts/update-session builds them into your home"
    fi
    say "session entry: $root$session_entry"
    if [ -n "$lightdm_dropin" ]; then
        say "LightDM drop-in: $root$lightdm_dropin (adds /usr/local's sessions)"
    fi
    if [ -n "$pam_stacks" ]; then
        say "lock screen's PAM service: $root$pam_file, with"
        say "  $pam_auth"
        say "  $pam_account"
    fi
    if [ -n "$session_note" ]; then
        say "note: $session_note"
    fi
    if [ -n "$autologin" ]; then
        echo
        bold "This machine logs in automatically:"
        say "$autologin, so no login screen appears to choose Slipstream on."
        say "$autologin_note"
    fi
    if [ -n "$required" ]; then
        echo
        bold "These have to be installed first:"
        printf '%s\n' "$required" | sed '1d'
        say ""
        # shellcheck disable=SC2086 # one word per package
        say "To add them: $(install_command $required_packages)"
    fi
    if [ -n "$limits" ]; then
        echo
        bold "What this system can't do:"
        printf '%s\n' "$limits" | sed '1d'
    fi
    if [ -n "$missing" ]; then
        echo
        bold "It will work, minus these:"
        printf '%s\n' "$missing" | sed '1d'
        say ""
        # shellcheck disable=SC2086 # one word per package
        say "To add them: $(install_command $missing_packages)"
        if [ "$atomic" = yes ]; then
            say "(Layering packages and rebooting is your call; this script never does it.)"
        fi
    fi
    if [ -n "$programs" ] && [ -x "$HOME/.local/bin/slipstream" ]; then
        echo
        bold "Your own copy comes first:"
        say "$HOME/.local/bin/slipstream is what your sessions will start, not the one being"
        say "installed. That's on purpose, so a build of your own keeps working. Remove it with"
        say "  rm -f ~/.local/bin/slipstream ~/.local/bin/slipstream-settings"
        say "to use this release instead. Other accounts on this machine are unaffected."
    fi
    if [ -e /usr/libexec/ublue-motd ] && ! [ -e "$HOME/.config/no-show-user-motd" ]; then
        echo
        bold "Worth knowing on Universal Blue:"
        say "The login banner (ublue-motd) waits forever for a terminal that's still starting, so a"
        say "terminal reopened with your layout can sit there taking no typing until Ctrl+C."
        say "To turn the banner off: touch ~/.config/no-show-user-motd"
    fi
    if [ -n "$problems" ]; then
        echo
        bold "It can't be installed here:"
        printf '%s\n' "$problems" | sed '1d'
    fi
}

# slipstream-portals.conf as installed. Slipstream answers screen sharing itself, through the
# wlroots backend; everything else (file choosers, secrets, dark mode, app chooser) goes to the
# portal backends this machine happens to have. They are listed in the order they are found,
# which is alphabetical and so favours no distribution, except that gtk goes last: it is the
# generic backend, the one any desktop can fall back to, so anything more specific gets asked
# first. A backend that can't answer an interface passes it to the next one in the list.
installed_portal_backends() {
    # shellcheck disable=SC2231 # portal_dirs is a list of folders
    for ipb_file in $(for ipb_dir in $portal_dirs; do echo "$ipb_dir"/*.portal; done); do
        if [ -r "$ipb_file" ]; then
            ipb_name=${ipb_file##*/}
            # wlr is named for screen sharing above; it implements nothing else.
            case ${ipb_name%.portal} in
                wlr | gtk) continue ;;
            esac
            printf '%s\n' "${ipb_name%.portal}"
        fi
    done | sort -u | tr '\n' ';' | sed 's/;$//'
}

write_portals_conf() {
    cat "$repo/session/slipstream-portals.conf"
    wpc_backends=$(installed_portal_backends)
    if portal_backend_installed gtk; then
        wpc_backends=${wpc_backends:+$wpc_backends;}gtk
    fi
    echo
    if [ -n "$wpc_backends" ]; then
        echo "# Every other interface goes to the backends installed here, in turn."
        echo "default=$wpc_backends"
    else
        echo "# No portal backend is installed beyond screen sharing's; anything installed later"
        echo "# answers the rest."
        echo "default=*"
    fi
}

# Whether a portal backend of that name is installed.
portal_backend_installed() {
    for pbi_dir in $portal_dirs; do
        if [ -e "$pbi_dir/$1.portal" ]; then
            return 0
        fi
    done
    return 1
}

inside_slipstream() {
    case "${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}" in
        Slipstream* | *:slipstream) return 0 ;;
    esac
    return 1
}

confirm() {
    if [ "$assume_yes" = yes ]; then
        return 0
    fi
    # Nothing to answer with when this isn't a terminal (a pipe, a test, a script): take it as no,
    # so an unattended run never installs or removes something nobody agreed to. --yes is there
    # for scripts that mean it.
    if [ ! -t 0 ]; then
        say "not asking (no terminal): taking that as no. --yes answers yes to everything."
        return 1
    fi
    printf '%s [y/N] ' "$1"
    read -r answer || answer=
    case $answer in y | Y | yes) return 0 ;; esac
    return 1
}

scratch=
cleanup() {
    if [ -n "$scratch" ]; then
        rm -rf "$scratch"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

new_scratch() {
    base=${XDG_RUNTIME_DIR:-/tmp}
    [ -d "$base" ] && [ -w "$base" ] || base=/tmp
    scratch=$(mktemp -d "$base/slipstream-install.XXXXXX")
    chmod 755 "$scratch"
}

# Runs the root half: `apply PLAN REMOVE`. PLAN lists files to put in place, one `mode<TAB>source<TAB>
# destination` per line; every one is copied beside its destination first, and only once all are
# there are they moved into place, so a failure part way leaves nothing changed. REMOVE lists
# files to delete afterwards. Written out and run with a single sudo, so there's one password
# prompt and no sudo timeout can land between two steps.
write_root_script() {
    cat >"$scratch/apply" <<'APPLY'
#!/bin/sh
set -eu
umask 022
plan=$1
remove=$2
tab=$(printf '\t')
unstage() {
    while IFS=$tab read -r _ _ dest; do
        if [ -n "$dest" ]; then
            rm -f "$dest.slipstream-new"
        fi
    done <"$plan"
}
trap unstage EXIT
n=0
while IFS=$tab read -r mode src dest; do
    [ -n "$dest" ] || continue
    n=$((n + 1))
    if [ "${SLIPSTREAM_TEST_FAIL_AT:-0}" = "$n" ]; then
        echo "(test) failing before file $n" >&2
        exit 1
    fi
    dir=$(dirname "$dest")
    [ -d "$dir" ] || install -d -m755 "$dir"
    install -m"$mode" "$src" "$dest.slipstream-new"
done <"$plan"
while IFS=$tab read -r _ _ dest; do
    [ -n "$dest" ] || continue
    mv -f "$dest.slipstream-new" "$dest"
    if command -v restorecon >/dev/null 2>&1; then
        restorecon "$dest" 2>/dev/null || true
    fi
done <"$plan"
while IFS= read -r path; do
    [ -n "$path" ] || continue
    rm -f "$path"
    case $path in
        */share/slipstream/installed) rmdir "$(dirname "$path")" 2>/dev/null || true ;;
    esac
done <"$remove"
exit 0
APPLY
}

# How to become root. With no terminal to type a password into — run from a file manager, a
# launcher, or a shell that isn't attached to one — sudo can ask through a graphical helper
# instead, which is what SUDO_ASKPASS is for.
sudo_run=sudo
if [ ! -t 0 ] && [ -z "$root" ]; then
    if [ -z "${SUDO_ASKPASS:-}" ]; then
        for helper in /usr/bin/ksshaskpass /usr/libexec/openssh/gnome-ssh-askpass \
            /usr/bin/lxqt-openssh-askpass /usr/bin/x11-ssh-askpass /usr/bin/ssh-askpass; do
            if [ -x "$helper" ]; then
                SUDO_ASKPASS=$helper
                export SUDO_ASKPASS
                break
            fi
        done
    fi
    if [ -n "${SUDO_ASKPASS:-}" ]; then
        sudo_run="sudo -A"
    fi
fi

as_root() {
    if [ -n "$root" ]; then
        sh "$@"
    else
        # shellcheck disable=SC2086 # sudo_run is a command with its options
        $sudo_run sh "$@"
    fi
}

# Every path in a manifest that this script is allowed to remove, one per line.
manifest_paths() {
    [ -r "$root$manifest" ] || return 0
    while IFS= read -r mp_path; do
        if ours "$mp_path"; then
            printf '%s\n' "$mp_path"
        elif [ -n "$mp_path" ]; then
            echo "install-session: ignoring '$mp_path' in the manifest: not a file Slipstream writes" >&2
        fi
    done <"$root$manifest"
}

# ---------------------------------------------------------------------------------------------

if [ "$mode" = uninstall ]; then
    if inside_slipstream; then
        echo "install-session: you're inside a Slipstream session right now." >&2
        echo "Removing it would pull the desktop out from under itself and leave the next login" >&2
        echo "with nothing to start. Log into another desktop and run this from there." >&2
        exit 1
    fi
    config=${XDG_CONFIG_HOME:-$HOME/.config}
    data=${XDG_DATA_HOME:-$HOME/.local/share}
    state=${XDG_STATE_HOME:-$HOME/.local/state}
    # What the manifest lists, plus what earlier versions of this script wrote without one. A file
    # that exists but wasn't written by Slipstream stays.
    candidates_list=$(
        {
            manifest_paths
            printf '%s\n' "$session_launcher" /usr/local/share/wayland-sessions/slipstream.desktop \
                "$session_entry" "$pam_file" "$portals_conf" "$wlr_conf" "$installed_bin" \
                "$installed_settings" "$settings_entry" "$session_target" "$shutdown_target" \
                "$manifest"
        } | sed '/^$/d' | sort -u
    )
    system_files=
    kept=
    while IFS= read -r path; do
        [ -n "$path" ] && [ -e "$root$path" ] || continue
        if written_by_slipstream "$path"; then
            system_files="$system_files$root$path
"
        else
            kept="$kept$root$path
"
        fi
    done <<EOF
$candidates_list
EOF
    user_files="$HOME/.local/bin/slipstream
$HOME/.local/bin/slipstream-settings
$data/applications/io.github.peterwalker78.SlipstreamSettings.desktop
$config/systemd/user/slipstream-session.target
$config/systemd/user/slipstream-shutdown.target
$config/xdg-desktop-portal/slipstream-portals.conf
$config/xdg-desktop-portal-wlr/Slipstream"
    bold "This removes:"
    printf '%s%s\n' "$system_files" "$user_files" | while IFS= read -r f; do
        if [ -n "$f" ] && [ -e "$f" ]; then
            say "$f"
        fi
    done
    if [ "$purge" = yes ]; then
        say "$config/slipstream (your settings)"
        say "$state/slipstream (the log and the remembered layout)"
    else
        echo
        bold "It leaves:"
        say "$config/slipstream (your settings) and $state/slipstream (the log and layout)."
        say "Add --purge to remove those too."
    fi
    if [ -n "$kept" ]; then
        printf '%s' "$kept" | while IFS= read -r f; do
            say "$f: not written by Slipstream, so it stays"
        done
    fi
    say "Packages such as xdg-desktop-portal-wlr stay: something else may be using them."
    echo
    confirm "Remove Slipstream?" || { echo "Nothing removed."; exit 1; }
    if [ -n "$system_files" ]; then
        new_scratch
        write_root_script
        : >"$scratch/plan"
        printf '%s' "$system_files" >"$scratch/remove"
        if ! as_root "$scratch/apply" "$scratch/plan" "$scratch/remove"; then
            echo "install-session: removing the system files failed; your own files were left too." >&2
            exit 1
        fi
    fi
    printf '%s\n' "$user_files" | while IFS= read -r f; do rm -f "$f"; done
    if [ "$purge" = yes ]; then
        rm -rf "$config/slipstream" "$state/slipstream"
    fi
    if [ -z "$root" ]; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    echo "Slipstream is gone from the login screen."
    exit 0
fi

check
report
if [ -n "$problems" ]; then
    echo
    echo "Nothing was written."
    exit 1
fi
if [ "$mode" = check ]; then
    exit 0
fi

# Packages before files: without the required ones there would be nothing to start, and asking
# once for everything keeps it to a single decision.
wanted_packages=$(printf '%s %s' "$required_packages" "$missing_packages" | tr ' ' '\n' \
    | sed '/^$/d' | sort -u | tr '\n' ' ' | sed 's/ $//')
if [ -n "$wanted_packages" ]; then
    echo
    if [ -z "$(install_now_command)" ]; then
        bold "Packages to install yourself"
        # shellcheck disable=SC2086 # one word per package
        say "$(install_command $wanted_packages)"
        if [ "$atomic" = yes ]; then
            say "On $os_name that rewrites the system image and takes effect after a reboot,"
            say "which is why this script won't do it for you."
        fi
        if [ -n "$required_packages" ]; then
            echo
            echo "Slipstream can't start without those, so nothing was written."
            exit 1
        fi
    else
        bold "Missing packages: $wanted_packages"
        if confirm "Install them with this system's package manager?"; then
            # shellcheck disable=SC2086 # one word per package
            if install_packages $wanted_packages; then
                if [ -n "$programs" ] && have ldd; then
                    still=$(missing_libraries "$programs/slipstream" "$programs/slipstream-settings" | tr '\n' ' ')
                    if [ -n "$still" ]; then
                        echo
                        echo "Slipstream still can't find: $still"
                        echo "Nothing else was written."
                        exit 1
                    fi
                fi
            elif [ -n "$required_packages" ]; then
                echo
                echo "Installing them didn't work, and Slipstream can't start without them."
                echo "Nothing was written."
                exit 1
            else
                echo
                say "Installing them didn't work. They were all optional, so this carries on;"
                # shellcheck disable=SC2086 # one word per package
                say "to add them later: $(install_command $wanted_packages)"
            fi
        elif [ -n "$required_packages" ]; then
            echo
            echo "Slipstream can't start without those, so nothing was written."
            exit 1
        fi
    fi
fi

echo
if [ -n "$root" ]; then
    bold "Installing under $root"
else
    if [ "$sudo_run" = sudo ]; then
        bold "Installing (sudo asks for your password)"
    else
        bold "Installing (a window asks for your password, since this isn't a terminal)"
    fi
    # `sudo -v` asks once, up front, so a password prompt doesn't land between two writes. Some
    # systems' sudo rules let a command through but not a bare validation, so a real command is
    # the second opinion before giving up.
    # shellcheck disable=SC2086 # sudo_run is a command with its options
    if ! $sudo_run -v && ! $sudo_run true; then
        echo
        echo "sudo didn't let this through, so nothing was written."
        exit 1
    fi
fi
new_scratch
write_root_script
plan=$scratch/plan
: >"$plan"
written=
put() {
    printf '%s\t%s\t%s\n' "$1" "$2" "$root$3" >>"$plan"
    written="$written$3
"
}
put 755 "$repo/session/slipstream-session" "$session_launcher"
put 644 "$repo/session/slipstream.desktop" "$session_entry"
# From a download, the programs go in too, for everyone with an account here, along with the
# files that belong with them: the Settings app's entry, the session's systemd units (a user
# manager reads /usr/local/lib/systemd/user), and the portal settings.
if [ -n "$programs" ]; then
    put 755 "$programs/slipstream" "$installed_bin"
    put 755 "$programs/slipstream-settings" "$installed_settings"
    put 644 "$repo/slipstream-settings/$settings_entry_name" "$settings_entry"
    put 644 "$repo/session/slipstream-session.target" "$session_target"
    put 644 "$repo/session/slipstream-shutdown.target" "$shutdown_target"
    write_portals_conf >"$scratch/portals.conf"
    put 644 "$scratch/portals.conf" "$portals_conf"
    # The picker the screen-sharing portal runs is this installed program.
    escaped=$(printf '%s\n' "$installed_bin" | sed 's/[\\&|]/\\&/g')
    sed "s|@SLIPSTREAM@|$escaped|" "$repo/session/xdg-desktop-portal-wlr.conf" >"$scratch/wlr.conf"
    put 644 "$scratch/wlr.conf" "$wlr_conf"
fi
if [ -n "$lightdm_dropin" ]; then
    printf '%s\n' \
        "$pam_marker: LightDM doesn't read /usr/local's sessions," \
        "# and /usr can't be written on this system. Removed by install-session --uninstall." \
        "[LightDM]" \
        "sessions-directory=/usr/local/share/wayland-sessions:/usr/share/lightdm/sessions:/usr/share/xsessions:/usr/share/wayland-sessions" \
        >"$scratch/lightdm.conf"
    put 644 "$scratch/lightdm.conf" "$lightdm_dropin"
fi
# The lock screen's PAM service. Without it the lock refuses to go up at all.
printf '%s\n' \
    "$pam_marker: the lock screen checks your password with this." \
    "# Removed by install-session --uninstall." \
    "$pam_auth" \
    "$pam_account" \
    >"$scratch/pam"
put 644 "$scratch/pam" "$pam_file"
# What was written, so --uninstall removes exactly that.
printf '%s%s\n' "$written" "$manifest" >"$scratch/installed"
put 644 "$scratch/installed" "$manifest"

# What an earlier install wrote that this one doesn't: a session entry in a folder the display
# manager no longer reads, a drop-in for a display manager that's gone, and the portal settings
# that are per-user now.
: >"$scratch/remove"
stale=$(
    manifest_paths
    echo /usr/local/share/xdg-desktop-portal/slipstream-portals.conf
)
while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "
$written$manifest
" in
        *"
$path
"*) continue ;;
    esac
    if [ -e "$root$path" ] && written_by_slipstream "$path"; then
        printf '%s\n' "$root$path" >>"$scratch/remove"
    fi
done <<EOF
$stale
EOF

if ! as_root "$scratch/apply" "$plan" "$scratch/remove"; then
    echo
    echo "Installing failed part way, and what had been copied was taken back: nothing changed."
    exit 1
fi
printf '%s' "$written" | while IFS= read -r f; do
    if [ -n "$f" ]; then
        say "$root$f"
    fi
done
while IFS= read -r f; do
    if [ -n "$f" ]; then
        say "removed $f (no longer used)"
    fi
done <"$scratch/remove"

# The login screen reads these as its own user: check they're really there, and readable.
for f in "$session_entry" "$session_launcher" "$pam_file"; do
    if ! [ -r "$root$f" ]; then
        echo "install-session: $root$f can't be read after installing; the login screen won't see it." >&2
        exit 1
    fi
done
if ! [ -x "$root$session_launcher" ]; then
    echo "install-session: $root$session_launcher isn't executable after installing." >&2
    exit 1
fi

if [ -z "$root" ]; then
    systemctl --user daemon-reload 2>/dev/null || true
    # Apps that come with Slipstream but are projects of their own, as Flatpaks for you alone.
    # Without flatpak it says so and changes nothing, and nothing here depends on them.
    if [ -n "$programs" ] && [ -x "$repo/scripts/install-extras" ] && have flatpak; then
        echo
        if ! "$repo/scripts/install-extras"; then
            echo "Not every app that comes with Slipstream installed; scripts/install-extras --check"
            echo "says more. Slipstream itself is installed."
        fi
    fi
fi

echo
if [ -n "$wayland_off" ]; then
    echo "Slipstream is installed, but GDM won't list it until its Wayland is on (see the note above)."
elif [ -n "$autologin" ]; then
    echo "Slipstream is installed. This machine logs in automatically, so see the note above for"
    echo "how to reach the session list."
elif [ -n "$programs" ] || [ -x "$HOME/.local/bin/slipstream" ]; then
    echo "Slipstream is on the login screen's session list. Log out and choose it there."
else
    echo "Slipstream is on the login screen's session list. Now run scripts/update-session to"
    echo "put the compositor in ~/.local/bin, which is what that entry starts."
fi
