#!/bin/sh
# Installs Slipstream and its Settings app in ~/.local, where the login session runs them. No root
# needed, bar the one file that can't live in a home: the launcher the login screen runs, which is
# refreshed only when it has changed. The compositor's changes take effect at the next login; the
# Settings app's straight away.
#
#   scripts/update-session                build (in the `slipstream` distrobox if there is one), then install
#   scripts/update-session --no-extras    the same, without building or updating the apps that
#                                         come with Slipstream (they can take a while)
#
# In an unpacked release, which carries the programs ready-built in bin/, nothing is built.
#
# Every file is copied beside its destination and then moved into place, so an interrupted update
# never leaves half a program for the next login to start.
set -eu
umask 022

if [ "$(id -u)" -eq 0 ]; then
    echo "update-session: run this as your own user, not as root: it installs into your home." >&2
    exit 2
fi
extras=yes
case ${1:-} in
    "") ;;
    --no-extras) extras=no ;;
    -h | --help)
        sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "update-session: unknown option $1 (try --help)" >&2
        exit 2
        ;;
esac
if [ -z "${HOME:-}" ] || ! [ -d "$HOME" ]; then
    echo "update-session: HOME isn't set to a folder." >&2
    exit 2
fi
# A container has its own /usr, and almost everything this script decides is read from the
# machine's: which portal backends are installed, and whether the launcher the login screen runs
# is the one in this copy. Both come out wrong in here, and the home it installs into is shared,
# so the wrong answers would be written where the real session reads them. Building in the
# `slipstream` box is what the box is for, and this script enters it itself, from outside.
if [ -f /run/.containerenv ] || [ -f /run/.dockerenv ]; then
    if [ -z "${SLIPSTREAM_TEST_ROOT:-}" ]; then
        echo "update-session: this is running inside a container, which has a /usr of its own." >&2
        echo "The portal backends it would list and the login screen's launcher belong to the" >&2
        echo "machine and aren't visible here, so it would install the wrong ones into your home." >&2
        echo "Run it on the host instead: it enters the slipstream box to build." >&2
        # distrobox leaves a way back out to the host in every container it makes, so from a box
        # there's no need to go and find another terminal.
        if command -v distrobox-host-exec >/dev/null 2>&1; then
            echo "From in here, that is: distrobox-host-exec $0 $*" >&2
        fi
        exit 2
    fi
fi

repo=$(cd "$(dirname "$0")/.." && pwd -P)
have() { command -v "$1" >/dev/null 2>&1; }

# Whether a distrobox called exactly `slipstream` exists.
has_box() {
    have distrobox || return 1
    distrobox list --no-color 2>/dev/null | awk -F'|' '
        { name = $2; gsub(/^[ \t]+|[ \t]+$/, "", name); if (name == "slipstream") found = 1 }
        END { exit !found }'
}

if [ -x "$repo/bin/slipstream" ] && ! [ -f "$repo/Cargo.toml" ]; then
    built=$repo/bin
    echo "Installing the release's programs from $built"
else
    if has_box; then
        # Fedora Atomic hosts see /var/home; the box sees /home. A login shell, so rustup's cargo is
        # on PATH.
        case $repo in
            /var/home/*) box_repo=${repo#/var} ;;
            *) box_repo=$repo ;;
        esac
        # shellcheck disable=SC2016 # expanded by the box's shell, from the argument after it
        distrobox enter slipstream -- bash -lc 'cd "$1" && cargo build --locked' _ "$box_repo"
    elif have cargo; then
        (cd "$repo" && cargo build --locked)
    else
        echo "update-session: no cargo to build with, and no slipstream distrobox." >&2
        echo "Install Rust (https://rustup.rs) and try again, or use a release with bin/ in it." >&2
        exit 1
    fi
    built=${CARGO_TARGET_DIR:-$repo/target}/debug
fi

for program in slipstream slipstream-settings; do
    if ! [ -x "$built/$program" ]; then
        echo "update-session: $built/$program isn't there, so nothing was installed." >&2
        exit 1
    fi
done

# A binary built in a box links the box's libraries, and a release's links the system it was built
# for: say so now rather than at the next login.
if have ldd; then
    for program in slipstream slipstream-settings; do
        libs=$(ldd "$built/$program" 2>&1 | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p' | tr '\n' ' ')
        if [ -n "$libs" ]; then
            echo "update-session: $program links libraries this system doesn't have: $libs" >&2
            echo "Nothing was installed. scripts/install-session --check names the packages." >&2
            exit 1
        fi
    done
fi
if ! version=$("$built/slipstream" --version 2>&1); then
    echo "update-session: the compositor doesn't run on this system:" >&2
    printf '  %s\n' "$version" >&2
    echo "Nothing was installed." >&2
    exit 1
fi

# `put MODE SOURCE DEST`: copied beside DEST, then moved over it in one step.
put() {
    mkdir -p "$(dirname "$3")"
    cp "$2" "$3.slipstream-new"
    chmod "$1" "$3.slipstream-new"
    mv -f "$3.slipstream-new" "$3"
}
# The same, for text made here rather than copied.
put_text() {
    mkdir -p "$(dirname "$2")"
    cat >"$2.slipstream-new"
    chmod "$1" "$2.slipstream-new"
    mv -f "$2.slipstream-new" "$2"
}
# Puts this copy's launcher where the login screen reads it. The same copy-beside-and-move as
# above, so a login starting mid-update still reads a whole file, and all of it in one `sh -c`
# under one sudo, so there's a single password prompt rather than one per step. Root without a
# password is tried first: an update run from somewhere nothing can be typed then says what to do
# instead of waiting at a prompt nobody will see.
refresh_launcher() {
    # shellcheck disable=SC2016 # expanded by the shell that runs it, from the arguments after it
    refresh_step='cp "$1" "$2.slipstream-new" && chmod 755 "$2.slipstream-new" && mv -f "$2.slipstream-new" "$2"'
    if [ -n "${SLIPSTREAM_TEST_ROOT:-}" ]; then
        mkdir -p "$(dirname "$launcher")"
        sh -c "$refresh_step" _ "$repo/session/slipstream-session" "$launcher"
        return
    fi
    if ! have sudo; then
        return 1
    fi
    if sudo -n sh -c "$refresh_step" _ "$repo/session/slipstream-session" "$launcher" 2>/dev/null; then
        return 0
    fi
    if ! [ -t 0 ]; then
        return 1
    fi
    echo "The login screen's launcher has changed; sudo asks for your password to replace it."
    sudo sh -c "$refresh_step" _ "$repo/session/slipstream-session" "$launcher"
}

bin_dir=$HOME/.local/bin
config=${XDG_CONFIG_HOME:-$HOME/.config}
data=${XDG_DATA_HOME:-$HOME/.local/share}
# The one file the login screen runs that no copy in a home can stand in for: it sets the
# session's environment before the compositor starts, so a change to it reaches the next login
# only once the installed copy is replaced. scripts/install-session writes it, and everything
# else Slipstream needs outside a home; this script keeps just this file in step.
launcher=${SLIPSTREAM_TEST_ROOT:-}/usr/local/bin/slipstream-session

put 755 "$built/slipstream" "$bin_dir/slipstream"
put 755 "$built/slipstream-settings" "$bin_dir/slipstream-settings"
# The Settings app's entry, so the explorer lists it (in Slipstream only).
entry=io.github.peterwalker78.SlipstreamSettings.desktop
put 644 "$repo/slipstream-settings/$entry" "$data/applications/$entry"
# The session targets, which the compositor starts so graphical-session.target comes up and the
# portal will run. They're per-user units, and ~/.config/systemd/user is the first directory the
# user manager searches, so this needs no root.
put 644 "$repo/session/slipstream-session.target" "$config/systemd/user/slipstream-session.target"
put 644 "$repo/session/slipstream-shutdown.target" "$config/systemd/user/slipstream-shutdown.target"
systemctl --user daemon-reload 2>/dev/null || true
# Which portal backend answers what under Slipstream: screen sharing's, and that backend's picker.
# All of it is per-user and named for Slipstream, so no root is needed and no other desktop's
# session is touched.
# The same file scripts/install-session writes, with the default naming the portal backends this
# machine has: Slipstream is its own desktop, so no other desktop's configuration is consulted.
{
    cat "$repo/session/slipstream-portals.conf"
    backends=$(
        for file in /usr/share/xdg-desktop-portal/portals/*.portal \
            /usr/local/share/xdg-desktop-portal/portals/*.portal; do
            if [ -r "$file" ]; then
                name=${file##*/}
                case ${name%.portal} in
                    wlr | gtk | slipstream) continue ;;
                esac
                printf '%s\n' "${name%.portal}"
            fi
        done | sort -u | tr '\n' ';' | sed 's/;$//'
    )
    if [ -e /usr/share/xdg-desktop-portal/portals/gtk.portal ]; then
        backends=${backends:+$backends;}gtk
    fi
    echo
    echo "# Every other interface goes to the backends installed here, in turn."
    echo "default=${backends:-*}"
} | put_text 644 "$config/xdg-desktop-portal/slipstream-portals.conf"
# Slipstream's own portal backend, which answers what apps ask about dark and light. The data
# folder of this one home is the first place xdg-desktop-portal looks, so this needs no root and
# takes the place of an installed release's copy in /usr/local for whoever runs update-session.
put 644 "$repo/session/slipstream.portal" "$data/xdg-desktop-portal/portals/slipstream.portal"
# The binary's path goes into a sed replacement, where \, & and the | delimiter are special.
escaped=$(printf '%s\n' "$bin_dir/slipstream" | sed 's/[\\&|]/\\&/g')
sed "s|@SLIPSTREAM@|$escaped|" "$repo/session/xdg-desktop-portal-wlr.conf" \
    | put_text 644 "$config/xdg-desktop-portal-wlr/Slipstream"

echo "Installed $version."
# Apps that are projects of their own, shipped in extras/ or described in ~/.config/slipstream/extras,
# built or downloaded as Flatpaks. Slipstream is already installed by now, so one that fails only says so.
if [ "$extras" = yes ]; then
    if ! "$repo/scripts/install-extras"; then
        echo "update-session: not every extra app installed; scripts/install-extras --check says more." >&2
    fi
else
    echo "Skipped the apps that come with Slipstream (--no-extras)."
fi
if [ ! -x "$launcher" ]; then
    echo "Run scripts/install-session once to add Slipstream to the login screen."
# Nothing to do when the two are the same file, which is the usual case: the launcher changes
# far less often than the programs do. Without cmp there's no telling, and a password prompt on
# every update would be worse than leaving it to install-session.
elif ! have cmp || cmp -s "$repo/session/slipstream-session" "$launcher"; then
    echo "Log out and choose Slipstream on the login screen."
elif refresh_launcher; then
    echo "Refreshed the launcher the login screen runs."
    echo "Log out and choose Slipstream on the login screen."
else
    echo "update-session: the installed session launcher isn't the one in this copy of Slipstream," >&2
    echo "so the next login would start the session as it was set up before. Everything else is" >&2
    echo "installed; run scripts/install-session to bring the launcher up to date." >&2
fi
