#!/bin/sh
# Installs or updates apps and plugins that belong with your Slipstream desktop but are projects of
# their own, for your user: apps as Flatpaks, plugins in ~/.local/share/slipstream/plugins. Each is
# described by a file: Slipstream ships some in extras/, and
# a file of your own in ~/.config/slipstream/extras/ adds another or, with the same name, replaces a
# shipped one (install=no alone leaves it out). update-session runs this after installing Slipstream;
# it can also be run on its own.
#
#   scripts/install-extras           install or update every app described there
#   scripts/install-extras --check   say what would be done; changes nothing
#   scripts/install-extras --ask     first ask about each shipped app that isn't installed yet;
#                                    no is remembered as install=no in a file of your own
#
# A file is lines of KEY=value, with no quotes. Blank lines, lines starting with #, and anything after
# a space and a # are skipped.
#
#   app_id=org.example.App             an app: the Flatpak's app ID
#   plugin=example                     or a plugin: its ID, which is the name of its folder
#   checkout=~/Projects/app            a local checkout of the project, and the command, run in it,
#   build=scripts/flatpak              that builds the Flatpak and installs it for this user, or
#   built=dist/example                 for a plugin, the folder in the checkout the build makes
#   bundle_url=https://.../app.flatpak otherwise, a single-file Flatpak bundle, or a .tar.gz holding
#   bundle_sha256=0123...              a plugin's folder, to download, and the SHA-256 it must have
#                                      (or bundle_sha256_url= to fetch it); https only
#   bundle_signer=ssh-ed25519 AAAA...  the public key the bundle is signed with: the .sig beside it,
#                                      made by ssh-keygen -Y sign -n slipstream-extra, must match
#   commands=bin/example               a plugin's programs to link into ~/.local/bin, by their paths
#                                      in its folder, separated by spaces; each link leads to the
#                                      copy of the plugin you approved in Settings
#   then=Run example setup             what to say once a plugin is first installed
#   default_browser=yes                make it the default web browser, once
#   install=no                         don't install it at all
#   about=Name, what it is: URL        what --ask says about it
#
# A checkout is built when the app isn't installed or the checkout's commit has changed since it was
# last built here (uncommitted changes don't count); if that build fails and the app isn't installed,
# the bundle is installed instead, when there is one. A bundle is installed when the app isn't
# installed or the bundle's checksum has changed. The default browser is set the first time only,
# so choosing another browser afterwards sticks. A plugin is installed off, and Settings › Plugins
# turns it on once you have looked at what it is. Each install records where it came from (from=
# release or checkout), which Settings shows beside a plugin an update has held.
set -eu
umask 022

check=no
ask=no
while [ $# -gt 0 ]; do
    case $1 in
        --check) check=yes ;;
        --ask) ask=yes ;;
        -h | --help)
            sed -n '2,41p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "install-extras: unknown option $1 (try --help)" >&2
            exit 2
            ;;
    esac
    shift
done
# Tests set SLIPSTREAM_TEST_EXTRAS, since CI runs them as root in a container.
if [ "$(id -u)" -eq 0 ] && [ -z "${SLIPSTREAM_TEST_EXTRAS:-}" ]; then
    echo "install-extras: run this as your own user, not as root: it installs into your home." >&2
    exit 2
fi
if [ -z "${HOME:-}" ] || ! [ -d "$HOME" ]; then
    echo "install-extras: HOME isn't set to a folder." >&2
    exit 2
fi

extras=${XDG_CONFIG_HOME:-$HOME/.config}/slipstream/extras
state=${XDG_STATE_HOME:-$HOME/.local/state}/slipstream/extras
cache=${XDG_CACHE_HOME:-$HOME/.cache}/slipstream/extras
plugins=${XDG_DATA_HOME:-$HOME/.local/share}/slipstream/plugins
# Where Slipstream keeps the copy of each plugin you approved, behind a link called current.
approved=${XDG_STATE_HOME:-$HOME/.local/state}/slipstream/plugins
have() { command -v "$1" >/dev/null 2>&1; }

# The apps Slipstream ships, beside this script. Tests point it elsewhere.
defaults=${SLIPSTREAM_EXTRAS_DEFAULTS:-$(cd "$(dirname "$0")/.." && pwd -P)/extras}

# Your own files, then each shipped one you haven't replaced with a file of the same name.
set --
for file in "$extras"/*.conf; do
    if [ -e "$file" ]; then
        set -- "$@" "$file"
    fi
done
for file in "$defaults"/*.conf; do
    if [ -e "$file" ] && ! [ -e "$extras/$(basename "$file")" ]; then
        set -- "$@" "$file"
    fi
done
if [ $# -eq 0 ]; then
    exit 0
fi

failed=0

# `say NAME TEXT`: a line about one app.
say() { printf '%s: %s\n' "$1" "$2"; }

# `recorded FILE KEY`: what was recorded under KEY for an app, or nothing.
recorded() {
    if [ -f "$1" ]; then
        sed -n "s/^$2=//p" "$1" | tail -n 1
    fi
}

# `record FILE KEY VALUE`: records VALUE under KEY, replacing what was there.
record() {
    mkdir -p "$(dirname "$1")"
    if [ -f "$1" ]; then
        grep -v "^$2=" "$1" >"$1.new" || true
    else
        : >"$1.new"
    fi
    printf '%s=%s\n' "$2" "$3" >>"$1.new"
    mv -f "$1.new" "$1"
}

# `agreed NAME ABOUT`: asks whether to install a shipped app. A no is written down in a file of
# your own, so it isn't asked again. With no terminal to answer from, it's left out this time only.
agreed() {
    if [ "$check" = yes ]; then
        say "$1" "would ask whether to install it"
        return 1
    fi
    # Tests answer through SLIPSTREAM_TEST_REPLY, since they have no terminal.
    if [ -n "${SLIPSTREAM_TEST_EXTRAS:-}" ] && [ -n "${SLIPSTREAM_TEST_REPLY+set}" ]; then
        answer=$SLIPSTREAM_TEST_REPLY
    elif [ -t 0 ]; then
        echo
        echo "Slipstream comes with ${2:-$1}."
        printf 'Install it? [y/N] '
        read -r answer || answer=
    else
        say "$1" "not asking (no terminal): left out this time; scripts/install-extras installs it"
        return 1
    fi
    case $answer in
        y | Y | yes) return 0 ;;
    esac
    mkdir -p "$extras"
    printf '# You chose not to install this app. Delete this file to be asked again.\ninstall=no\n' \
        >"$extras/$1.conf"
    say "$1" "left out; delete $extras/$1.conf to be asked again"
    return 1
}

# `sha_of FILE`: its SHA-256.
sha_of() { sha256sum "$1" | cut -d ' ' -f 1; }

# `fetch URL FILE`: downloads URL to FILE, over https only, redirects included. Tests may also
# fetch file:// URLs, through SLIPSTREAM_TEST_FILE_URLS.
fetch() {
    fetch_protos='=https'
    if [ -n "${SLIPSTREAM_TEST_EXTRAS:-}" ] && [ -n "${SLIPSTREAM_TEST_FILE_URLS:-}" ]; then
        fetch_protos='=https,file'
    fi
    case $fetch_protos:$1 in
        =https:https://* | =https,file:https://* | =https,file:file://*) ;;
        *)
            echo "won't download $1: only https:// addresses are used" >&2
            return 1
            ;;
    esac
    if have curl; then
        curl --fail --silent --show-error --location --proto "$fetch_protos" --proto-redir =https \
            --output "$2" "$1"
    elif have wget; then
        # wget can't keep a redirect to https, so it only fetches what a signature then checks.
        if [ -z "${bundle_signer:-}" ]; then
            echo "won't download $1 with wget: install curl, which keeps every redirect to https" >&2
            return 1
        fi
        wget --quiet --output-document="$2" "$1"
    else
        echo "neither curl nor wget is installed to download with" >&2
        return 1
    fi
}

# `from_checkout NAME` for the app read into the variables below. Returns 1 when it failed.
from_checkout() {
    commit=$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)
    if [ -z "$commit" ]; then
        say "$1" "$checkout isn't a git checkout, so it can't tell what's changed"
        return 1
    fi
    if [ "$installed" = yes ] && [ "$(recorded "$record_file" built)" = "$commit" ]; then
        say "$1" "up to date with its checkout"
        if [ -n "$plugin" ] && [ "$check" = no ]; then
            link_commands "$1"
            unapproved=''
        fi
        return 0
    fi
    if [ "$check" = yes ]; then
        say "$1" "would build and install from $checkout (commit $(printf %.12s "$commit"))"
        return 0
    fi
    say "$1" "building and installing from $checkout"
    if ! (cd "$checkout" && sh -c "$build"); then
        say "$1" "the build failed; the installed version, if any, is unchanged" >&2
        return 1
    fi
    if [ -n "$plugin" ]; then
        if [ -z "$built" ]; then
            say "$1" "a plugin's checkout needs built, the folder its build makes" >&2
            return 1
        fi
        put_plugin "$1" "$checkout/$built" || return 1
    elif ! flatpak info --user "$app_id" >/dev/null 2>&1; then
        say "$1" "the build finished but $app_id isn't installed for this user" >&2
        return 1
    fi
    record "$record_file" built "$commit"
    record "$record_file" from checkout
    say "$1" "installed"
}

# `from_bundle NAME` for the app read into the variables below. Returns 1 when it failed.
from_bundle() {
    want=$bundle_sha256
    if [ -z "$want" ] && [ -n "$bundle_sha256_url" ]; then
        mkdir -p "$cache"
        if ! fetch "$bundle_sha256_url" "$cache/$name.sha256"; then
            say "$1" "couldn't download the bundle's checksum from $bundle_sha256_url" >&2
            return 1
        fi
        want=$(cut -d ' ' -f 1 "$cache/$name.sha256" | head -n 1)
    fi
    if [ -z "$want" ]; then
        say "$1" "bundle_url needs bundle_sha256 or bundle_sha256_url, so the download can be checked" >&2
        return 1
    fi
    if [ "$installed" = yes ] && [ "$(recorded "$record_file" bundle)" = "$want" ]; then
        say "$1" "up to date with its bundle"
        if [ -n "$plugin" ] && [ "$check" = no ]; then
            link_commands "$1"
            unapproved=''
        fi
        return 0
    fi
    if [ "$check" = yes ]; then
        say "$1" "would download and install $bundle_url"
        return 0
    fi
    if [ -n "$bundle_signer" ] && ! have ssh-keygen; then
        say "$1" "ssh-keygen, which comes with OpenSSH, isn't installed to check who signed the bundle; nothing was installed" >&2
        return 1
    fi
    mkdir -p "$cache"
    bundle=$cache/$name.bundle
    say "$1" "downloading $bundle_url"
    if ! fetch "$bundle_url" "$bundle.part"; then
        rm -f "$bundle.part"
        say "$1" "the download failed" >&2
        return 1
    fi
    got=$(sha_of "$bundle.part")
    if [ "$got" != "$want" ]; then
        rm -f "$bundle.part"
        say "$1" "the download's SHA-256 is $got, not $want; nothing was installed" >&2
        return 1
    fi
    if [ -n "$bundle_signer" ] && ! signed_by_signer "$1" "$bundle.part"; then
        rm -f "$bundle.part"
        return 1
    fi
    mv -f "$bundle.part" "$bundle"
    if [ -n "$plugin" ]; then
        unpacked=$cache/$name.unpacked
        rm -rf "$unpacked"
        mkdir -p "$unpacked"
        if ! tar -xzf "$bundle" -C "$unpacked" --no-same-owner; then
            rm -rf "$unpacked"
            say "$1" "the bundle isn't a .tar.gz that could be unpacked" >&2
            return 1
        fi
        if ! put_plugin "$1" "$unpacked/$plugin"; then
            rm -rf "$unpacked"
            return 1
        fi
        rm -rf "$unpacked"
    elif ! flatpak install --user --noninteractive --reinstall --bundle "$bundle"; then
        say "$1" "flatpak couldn't install the bundle" >&2
        return 1
    fi
    record "$record_file" bundle "$want"
    record "$record_file" from release
    say "$1" "installed"
}

# `signed_by_signer NAME FILE`: whether the .sig published beside the bundle shows FILE was signed
# with the key in bundle_signer. Says why not when it wasn't.
signed_by_signer() {
    if ! fetch "$bundle_url.sig" "$cache/$name.sig"; then
        say "$1" "couldn't download the bundle's signature from $bundle_url.sig; nothing was installed" >&2
        rm -f "$cache/$name.sig"
        return 1
    fi
    printf 'extra %s\n' "$bundle_signer" >"$cache/$name.signers"
    signed_status=0
    ssh-keygen -Y verify -f "$cache/$name.signers" -I extra -n slipstream-extra \
        -s "$cache/$name.sig" <"$2" >/dev/null 2>&1 || signed_status=$?
    rm -f "$cache/$name.sig" "$cache/$name.signers"
    if [ "$signed_status" -ne 0 ]; then
        say "$1" "the download isn't signed with the key in bundle_signer; nothing was installed" >&2
        return 1
    fi
}

# `put_plugin NAME FOLDER`: puts the plugin in FOLDER in place of the one installed, and links its
# commands. FOLDER must hold a plugin.toml and no symbolic links, as Slipstream asks of a plugin.
put_plugin() {
    if ! [ -f "$2/plugin.toml" ]; then
        say "$1" "$2 has no plugin.toml, so it isn't a plugin" >&2
        return 1
    fi
    if [ -n "$(find "$2" -type l | head -n 1)" ]; then
        say "$1" "$2 holds symbolic links, which Slipstream won't load" >&2
        return 1
    fi
    mkdir -p "$plugins" "$cache"
    rm -rf "${cache:?}/$plugin.new" "${cache:?}/$plugin.old"
    cp -R "$2" "$cache/$plugin.new"
    if [ -d "$plugins/$plugin" ]; then
        mv "$plugins/$plugin" "$cache/$plugin.old"
    fi
    mv "$cache/$plugin.new" "$plugins/$plugin"
    rm -rf "${cache:?}/$plugin.old"
    link_commands "$1"
}

# `link_commands NAME`: links the installed plugin's commands into ~/.local/bin. Each leads through
# the current link, which Slipstream moves to the copy you approved, so a command never runs a
# plugin you haven't seen. A program of the same name that isn't a link is someone's own, and is
# left alone. A link from an older install that still leads to a program is kept until there is
# an approved copy to lead to, so the command keeps working until the plugin is turned on.
link_commands() {
    for put_command in $commands; do
        put_link=$HOME/.local/bin/${put_command##*/}
        if ! [ -f "$plugins/$plugin/$put_command" ] || ! [ -x "$plugins/$plugin/$put_command" ]; then
            say "$1" "$put_command isn't a program in the plugin, so it wasn't linked" >&2
            continue
        fi
        if [ -e "$put_link" ] && ! [ -L "$put_link" ]; then
            say "$1" "left $put_link as it is; remove it to use the plugin's ${put_command##*/}" >&2
            continue
        fi
        put_target=$approved/$plugin/current/$put_command
        if [ -L "$put_link" ] && [ "$(readlink "$put_link")" != "$put_target" ] &&
            [ -e "$put_link" ] && ! [ -e "$put_target" ]; then
            unapproved=yes
            continue
        fi
        mkdir -p "$HOME/.local/bin"
        ln -sf "$put_target" "$put_link"
        if ! [ -e "$put_link" ]; then
            unapproved=yes
        fi
    done
}

# `make_default_browser NAME` for the app read into the variables below.
make_default_browser() {
    if [ "$(recorded "$record_file" default_browser)" = yes ]; then
        return 0
    fi
    if ! flatpak info --user "$app_id" >/dev/null 2>&1; then
        return 0
    fi
    if [ "$check" = yes ]; then
        say "$1" "would become the default web browser"
        return 0
    fi
    desktop=$app_id.desktop
    if have xdg-settings && xdg-settings set default-web-browser "$desktop" 2>/dev/null; then
        :
    elif have xdg-mime; then
        xdg-mime default "$desktop" x-scheme-handler/http x-scheme-handler/https text/html
    else
        say "$1" "neither xdg-settings nor xdg-mime is installed to make it the default browser" >&2
        return 1
    fi
    record "$record_file" default_browser yes
    say "$1" "is now the default web browser"
}

for file in "$@"; do
    name=$(basename "$file" .conf)
    record_file=$state/$name
    app_id='' plugin='' checkout='' build='' built='' bundle_url='' bundle_sha256=''
    bundle_sha256_url='' bundle_signer='' commands='' then='' default_browser=no install=yes about=''
    unapproved=''
    bad=no
    while IFS= read -r line || [ -n "$line" ]; do
        # Carriage returns from a file saved on Windows, and spaces round the edges.
        line=$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case $line in
            '' | '#'*) continue ;;
            *=*) ;;
            *)
                say "$name" "not KEY=value, skipped: $line" >&2
                continue
                ;;
        esac
        key=$(printf '%s' "${line%%=*}" | sed 's/[[:space:]]*$//')
        # A # after a space starts a comment.
        value=$(printf '%s' "${line#*=}" | sed 's/^[[:space:]]*//; s/[[:space:]]\{1,\}#.*$//')
        case $value in
            \~) value=$HOME ;;
            \~/*) value=$HOME/${value#\~/} ;;
        esac
        case $key in
            app_id) app_id=$value ;;
            plugin) plugin=$value ;;
            checkout) checkout=$value ;;
            build) build=$value ;;
            built) built=$value ;;
            commands) commands=$value ;;
            then) then=$value ;;
            bundle_url) bundle_url=$value ;;
            bundle_sha256) bundle_sha256=$value ;;
            bundle_sha256_url) bundle_sha256_url=$value ;;
            bundle_signer) bundle_signer=$value ;;
            default_browser) default_browser=$value ;;
            install) install=$value ;;
            about) about=$value ;;
            *) say "$name" "unknown key $key, skipped" >&2 ;;
        esac
    done <"$file"

    if [ "$install" = no ]; then
        say "$name" "left out (install=no in $file)"
        continue
    fi
    if [ -z "$app_id" ] && [ -z "$plugin" ]; then
        say "$name" "neither app_id nor plugin in $file" >&2
        bad=yes
    elif [ -n "$app_id" ] && [ -n "$plugin" ]; then
        say "$name" "both app_id and plugin in $file, when it is one or the other" >&2
        bad=yes
    elif [ -n "$plugin" ]; then
        # A folder name of letters, digits, '.', '-' and '_', starting with a letter or digit.
        case $plugin in
            [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*)
                say "$name" "plugin can only have letters, digits, '.', '-' and '_'" >&2
                bad=yes
                ;;
        esac
    elif ! have flatpak; then
        say "$name" "flatpak isn't installed, so this app can't be" >&2
        bad=yes
    fi
    if [ -n "$checkout" ] && [ -z "$build" ]; then
        say "$name" "checkout needs build, the command that builds and installs it" >&2
        bad=yes
    fi
    if [ "$bad" = yes ]; then
        failed=$((failed + 1))
        continue
    fi

    installed=no
    if [ -n "$plugin" ]; then
        if [ -f "$plugins/$plugin/plugin.toml" ]; then
            installed=yes
        fi
    elif flatpak info --user "$app_id" >/dev/null 2>&1; then
        installed=yes
    fi
    # Asked first: a shipped app that isn't installed yet, with no file of your own deciding.
    if [ "$ask" = yes ] && [ "$installed" = no ] && [ "$file" = "$defaults/$name.conf" ]; then
        if ! agreed "$name" "$about"; then
            continue
        fi
    fi
    status=0
    if [ -n "$checkout" ] && [ -d "$checkout" ]; then
        from_checkout "$name" || status=$?
        # A checkout that won't build still leaves a way in for an app that isn't installed at all.
        # One that is installed keeps its own build rather than going back to the published bundle.
        if [ "$status" -ne 0 ] && [ "$installed" = no ] && [ -n "$bundle_url" ]; then
            say "$name" "installing its bundle instead"
            status=0
            from_bundle "$name" || status=$?
        fi
    elif [ -n "$bundle_url" ]; then
        from_bundle "$name" || status=$?
    elif [ -n "$checkout" ]; then
        say "$name" "no checkout at $checkout and no bundle_url, so nothing to install from" >&2
        status=1
    else
        say "$name" "neither checkout nor bundle_url is set" >&2
        status=1
    fi
    if [ "$status" -ne 0 ]; then
        failed=$((failed + 1))
        continue
    fi
    if [ "$default_browser" = yes ]; then
        make_default_browser "$name" || failed=$((failed + 1))
    fi
    # Its commands lead nowhere until it is turned on.
    if [ -n "$plugin" ] && [ "$installed" = no ] && [ "$check" = no ]; then
        say "$name" "turn it on in Settings › Plugins${unapproved:+ to finish}${then:+. $then}"
    elif [ -n "$unapproved" ]; then
        say "$name" "turn it on in Settings › Plugins to finish"
    fi
done

if [ "$failed" -gt 0 ]; then
    exit 1
fi
