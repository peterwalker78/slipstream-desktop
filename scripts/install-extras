#!/bin/sh
# Installs or updates apps that belong with your Slipstream desktop but are projects of their own,
# as Flatpaks for your user. Each app is described by a file: Slipstream ships some in extras/, and
# a file of your own in ~/.config/slipstream/extras/ adds another or, with the same name, replaces a
# shipped one (install=no alone leaves it out). update-session runs this after installing Slipstream;
# it can also be run on its own.
#
#   scripts/install-extras           install or update every app described there
#   scripts/install-extras --check   say what would be done; changes nothing
#
# A file is lines of KEY=value, with no quotes. Blank lines, lines starting with #, and anything after
# a space and a # are skipped.
#
#   app_id=org.example.App             the Flatpak's app ID (required)
#   checkout=~/Projects/app            a local checkout of the app's project, and the command, run
#   build=scripts/flatpak              in it, that builds the Flatpak and installs it for this user
#   bundle_url=https://.../app.flatpak otherwise, a single-file Flatpak bundle to download, and the
#   bundle_sha256=0123...              SHA-256 it must have (or bundle_sha256_url= to fetch it)
#   default_browser=yes                make it the default web browser, once
#   install=no                         don't install this app at all
#
# A checkout is built when the app isn't installed or the checkout's commit has changed since it was
# last built here (uncommitted changes don't count); if that build fails and the app isn't installed,
# the bundle is installed instead, when there is one. A bundle is installed when the app isn't
# installed or the bundle's checksum has changed. The default browser is set the first time only,
# so choosing another browser afterwards sticks.
set -eu
umask 022

check=no
case ${1:-} in
    "") ;;
    --check) check=yes ;;
    -h | --help)
        sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "install-extras: unknown option $1 (try --help)" >&2
        exit 2
        ;;
esac
# Tests set SLIPSTREAM_TEST_EXTRAS, since CI runs them as root in a container.
if [ "$(id -u)" -eq 0 ] && [ -z "${SLIPSTREAM_TEST_EXTRAS:-}" ]; then
    echo "install-extras: run this as your own user, not as root: it installs into your home." >&2
    exit 2
fi
if [ -z "${HOME:-}" ] || ! [ -d "$HOME" ]; then
    echo "install-extras: HOME isn't set to a folder." >&2
    exit 2
fi

extras=${XDG_CONFIG_HOME:-$HOME/.config}/slipstream/extras
state=${XDG_STATE_HOME:-$HOME/.local/state}/slipstream/extras
cache=${XDG_CACHE_HOME:-$HOME/.cache}/slipstream/extras
have() { command -v "$1" >/dev/null 2>&1; }

# The apps Slipstream ships, beside this script. Tests point it elsewhere.
defaults=${SLIPSTREAM_EXTRAS_DEFAULTS:-$(cd "$(dirname "$0")/.." && pwd -P)/extras}

# Your own files, then each shipped one you haven't replaced with a file of the same name.
set --
for file in "$extras"/*.conf; do
    if [ -e "$file" ]; then
        set -- "$@" "$file"
    fi
done
for file in "$defaults"/*.conf; do
    if [ -e "$file" ] && ! [ -e "$extras/$(basename "$file")" ]; then
        set -- "$@" "$file"
    fi
done
if [ $# -eq 0 ]; then
    exit 0
fi
if ! have flatpak; then
    echo "install-extras: there are apps to install, but flatpak isn't installed." >&2
    exit 1
fi

failed=0

# `say NAME TEXT`: a line about one app.
say() { printf '%s: %s\n' "$1" "$2"; }

# `recorded FILE KEY`: what was recorded under KEY for an app, or nothing.
recorded() {
    if [ -f "$1" ]; then
        sed -n "s/^$2=//p" "$1" | tail -n 1
    fi
}

# `record FILE KEY VALUE`: records VALUE under KEY, replacing what was there.
record() {
    mkdir -p "$(dirname "$1")"
    if [ -f "$1" ]; then
        grep -v "^$2=" "$1" >"$1.new" || true
    else
        : >"$1.new"
    fi
    printf '%s=%s\n' "$2" "$3" >>"$1.new"
    mv -f "$1.new" "$1"
}

# `sha_of FILE`: its SHA-256.
sha_of() { sha256sum "$1" | cut -d ' ' -f 1; }

# `fetch URL FILE`: downloads URL to FILE.
fetch() {
    if have curl; then
        curl --fail --silent --show-error --location --output "$2" "$1"
    elif have wget; then
        wget --quiet --output-document="$2" "$1"
    else
        echo "neither curl nor wget is installed to download with" >&2
        return 1
    fi
}

# `from_checkout NAME` for the app read into the variables below. Returns 1 when it failed.
from_checkout() {
    commit=$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)
    if [ -z "$commit" ]; then
        say "$1" "$checkout isn't a git checkout, so it can't tell what's changed"
        return 1
    fi
    if [ "$installed" = yes ] && [ "$(recorded "$record_file" built)" = "$commit" ]; then
        say "$1" "up to date with its checkout"
        return 0
    fi
    if [ "$check" = yes ]; then
        say "$1" "would build and install from $checkout (commit $(printf %.12s "$commit"))"
        return 0
    fi
    say "$1" "building and installing from $checkout"
    if ! (cd "$checkout" && sh -c "$build"); then
        say "$1" "the build failed; the installed version, if any, is unchanged" >&2
        return 1
    fi
    if ! flatpak info --user "$app_id" >/dev/null 2>&1; then
        say "$1" "the build finished but $app_id isn't installed for this user" >&2
        return 1
    fi
    record "$record_file" built "$commit"
    say "$1" "installed"
}

# `from_bundle NAME` for the app read into the variables below. Returns 1 when it failed.
from_bundle() {
    want=$bundle_sha256
    if [ -z "$want" ] && [ -n "$bundle_sha256_url" ]; then
        mkdir -p "$cache"
        if ! fetch "$bundle_sha256_url" "$cache/$name.sha256"; then
            say "$1" "couldn't download the bundle's checksum from $bundle_sha256_url" >&2
            return 1
        fi
        want=$(cut -d ' ' -f 1 "$cache/$name.sha256" | head -n 1)
    fi
    if [ -z "$want" ]; then
        say "$1" "bundle_url needs bundle_sha256 or bundle_sha256_url, so the download can be checked" >&2
        return 1
    fi
    if [ "$installed" = yes ] && [ "$(recorded "$record_file" bundle)" = "$want" ]; then
        say "$1" "up to date with its bundle"
        return 0
    fi
    if [ "$check" = yes ]; then
        say "$1" "would download and install $bundle_url"
        return 0
    fi
    mkdir -p "$cache"
    bundle=$cache/$name.flatpak
    say "$1" "downloading $bundle_url"
    if ! fetch "$bundle_url" "$bundle.part"; then
        rm -f "$bundle.part"
        say "$1" "the download failed" >&2
        return 1
    fi
    got=$(sha_of "$bundle.part")
    if [ "$got" != "$want" ]; then
        rm -f "$bundle.part"
        say "$1" "the download's SHA-256 is $got, not $want; nothing was installed" >&2
        return 1
    fi
    mv -f "$bundle.part" "$bundle"
    if ! flatpak install --user --noninteractive --reinstall --bundle "$bundle"; then
        say "$1" "flatpak couldn't install the bundle" >&2
        return 1
    fi
    record "$record_file" bundle "$want"
    say "$1" "installed"
}

# `make_default_browser NAME` for the app read into the variables below.
make_default_browser() {
    if [ "$(recorded "$record_file" default_browser)" = yes ]; then
        return 0
    fi
    if ! flatpak info --user "$app_id" >/dev/null 2>&1; then
        return 0
    fi
    if [ "$check" = yes ]; then
        say "$1" "would become the default web browser"
        return 0
    fi
    desktop=$app_id.desktop
    if have xdg-settings && xdg-settings set default-web-browser "$desktop" 2>/dev/null; then
        :
    elif have xdg-mime; then
        xdg-mime default "$desktop" x-scheme-handler/http x-scheme-handler/https text/html
    else
        say "$1" "neither xdg-settings nor xdg-mime is installed to make it the default browser" >&2
        return 1
    fi
    record "$record_file" default_browser yes
    say "$1" "is now the default web browser"
}

for file in "$@"; do
    name=$(basename "$file" .conf)
    record_file=$state/$name
    app_id='' checkout='' build='' bundle_url='' bundle_sha256='' bundle_sha256_url=''
    default_browser=no install=yes
    bad=no
    while IFS= read -r line || [ -n "$line" ]; do
        # Carriage returns from a file saved on Windows, and spaces round the edges.
        line=$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case $line in
            '' | '#'*) continue ;;
            *=*) ;;
            *)
                say "$name" "not KEY=value, skipped: $line" >&2
                continue
                ;;
        esac
        key=$(printf '%s' "${line%%=*}" | sed 's/[[:space:]]*$//')
        # A # after a space starts a comment.
        value=$(printf '%s' "${line#*=}" | sed 's/^[[:space:]]*//; s/[[:space:]]\{1,\}#.*$//')
        case $value in
            \~) value=$HOME ;;
            \~/*) value=$HOME/${value#\~/} ;;
        esac
        case $key in
            app_id) app_id=$value ;;
            checkout) checkout=$value ;;
            build) build=$value ;;
            bundle_url) bundle_url=$value ;;
            bundle_sha256) bundle_sha256=$value ;;
            bundle_sha256_url) bundle_sha256_url=$value ;;
            default_browser) default_browser=$value ;;
            install) install=$value ;;
            *) say "$name" "unknown key $key, skipped" >&2 ;;
        esac
    done <"$file"

    if [ "$install" = no ]; then
        say "$name" "left out (install=no in $file)"
        continue
    fi
    if [ -z "$app_id" ]; then
        say "$name" "no app_id in $file" >&2
        bad=yes
    fi
    if [ -n "$checkout" ] && [ -z "$build" ]; then
        say "$name" "checkout needs build, the command that builds and installs it" >&2
        bad=yes
    fi
    if [ "$bad" = yes ]; then
        failed=$((failed + 1))
        continue
    fi

    installed=no
    if flatpak info --user "$app_id" >/dev/null 2>&1; then
        installed=yes
    fi
    status=0
    if [ -n "$checkout" ] && [ -d "$checkout" ]; then
        from_checkout "$name" || status=$?
        # A checkout that won't build still leaves a way in for an app that isn't installed at all.
        # One that is installed keeps its own build rather than going back to the published bundle.
        if [ "$status" -ne 0 ] && [ "$installed" = no ] && [ -n "$bundle_url" ]; then
            say "$name" "installing its bundle instead"
            status=0
            from_bundle "$name" || status=$?
        fi
    elif [ -n "$bundle_url" ]; then
        from_bundle "$name" || status=$?
    elif [ -n "$checkout" ]; then
        say "$name" "no checkout at $checkout and no bundle_url, so nothing to install from" >&2
        status=1
    else
        say "$name" "neither checkout nor bundle_url is set" >&2
        status=1
    fi
    if [ "$status" -ne 0 ]; then
        failed=$((failed + 1))
        continue
    fi
    if [ "$default_browser" = yes ]; then
        make_default_browser "$name" || failed=$((failed + 1))
    fi
done

if [ "$failed" -gt 0 ]; then
    exit 1
fi
