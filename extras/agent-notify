#!/bin/sh
# agent-notify: desktop notifications for terminal coding agents.
#
# Agents run it from their hooks when a task starts, when it finishes, and when it's waiting on
# you. A task that ran for long-task-secs or more is announced with a sound; anything shorter gets
# a quiet notification. Only an agent waiting on you after that long is critical, so a desktop that
# honours the spec wakes the screen for it: one that has simply finished can wait until you're
# back. Each session's notification replaces its previous one, and is withdrawn when you send the
# next prompt, since by then you've seen it.
#
# Everything goes over the standard org.freedesktop.Notifications interface, so it works on any
# desktop. The notification is sent from inside the agent's own process tree, which lets a server
# that looks (Slipstream does) tie it to the terminal window it came from.
#
# A session started with `keep` runs in the background, attached to the terminal it was started
# in, so it carries on when the window closes or you log out. That terminal is outside the
# session's process tree, so its notifications name it with the sender-pid hint, and it leaves
# Slipstream a note that attaches the window to the session again at the next login.
#
# The same hooks say whether the agent is working, for a desktop that shows it: Slipstream draws a
# trace on its faded wallpaper for each agent with a note in $XDG_RUNTIME_DIR/slipstream/working.
# The note is there while the session is open. It says what to call the trace (the agent, and what
# it is working on), whether the agent is working or idle, and what its subagents are doing. Each
# hook writes it afresh from what the agent itself records, where it keeps a record, so one hook
# missed or run out of order is put right by the next.
#
#   agent-notify setup [AGENT...]   wire up the agents in the config (naming some saves them there)
#   agent-notify setup --remove     take every hook back out
#   agent-notify status             what's configured, wired and listening, and where each session
#                                   the desktop shows is running
#   agent-notify test [--long]      send a sample notification
#   agent-notify usage [--refresh]  plan limits used, as JSON for a desktop meter (see Usage limits)
#   agent-notify keep claude [ARGS] start a session in the background, attached to this terminal;
#                                   alias claude='agent-notify keep claude' makes it the default
#   agent-notify hook AGENT EVENT   what the hooks run; EVENT is session_start, start, finish,
#                                   attention, working (the agent or a subagent has used a tool),
#                                   or step (the agent is calling its model: a start if it was idle)
#
# Agents: claude (Claude Code), gemini (Gemini CLI), codex (Codex CLI), agy (Antigravity CLI).
#
# Config, ~/.config/agent-notify/config, one "key = value" per line:
#   agents = claude gemini
#   long-task-secs = 120
#   sound-finished = complete
#   sound-attention = window-attention
#   usage-refresh-secs = 300
#   usage-alerts = 75 90 100

set -u

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/agent-notify/config
STATE=${XDG_RUNTIME_DIR:-/tmp/agent-notify-$(id -u)}/agent-notify
KNOWN_AGENTS="claude gemini codex agy"

# A desktop session's path is set before any shell profile runs, so agents installed with Homebrew
# aren't on it: look in Homebrew's standard places too.
for brew_bin in /home/linuxbrew/.linuxbrew/bin "$HOME/.linuxbrew/bin"; do
    case ":$PATH:" in
        *":$brew_bin:"*) ;;
        *) if [ -d "$brew_bin" ]; then PATH=$PATH:$brew_bin; fi ;;
    esac
done

# ---------------------------------------------------------------------------------------------
# Small helpers

# The value of `key` in the config, or `default`.
conf() {
    conf_value=
    if [ -r "$CONFIG" ]; then
        conf_value=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1)
    fi
    printf '%s' "${conf_value:-$2}"
}

have() { command -v "$1" >/dev/null 2>&1; }

# Seconds since boot: a clock that NTP and time zone changes can't move.
uptime_secs() {
    if read -r uptime_up _ </proc/uptime 2>/dev/null; then
        printf '%s' "${uptime_up%.*}"
    else
        date +%s
    fi
}

# 42s, 7m 12s, 1h 05m, 5d 23h.
duration() {
    if [ "$1" -lt 60 ]; then
        printf '%ss' "$1"
    elif [ "$1" -lt 3600 ]; then
        printf '%sm %02ds' $(($1 / 60)) $(($1 % 60))
    elif [ "$1" -lt 86400 ]; then
        printf '%sh %02dm' $(($1 / 3600)) $(($1 % 3600 / 60))
    else
        printf '%sd %02dh' $(($1 / 86400)) $(($1 % 86400 / 3600))
    fi
}

agent_name() {
    case $1 in
        claude) printf 'Claude Code' ;;
        gemini) printf 'Gemini CLI' ;;
        codex) printf 'Codex' ;;
        agy) printf 'Antigravity' ;;
        *) printf '%s' "$1" ;;
    esac
}

# What a desktop trace calls the agent: one short lowercase word.
agent_label() {
    case $1 in
        agy) printf 'antigravity' ;;
        *) printf '%s' "$1" ;;
    esac
}

is_number() {
    case $1 in
        '' | *[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# Makes $STATE, private to this user. Without a runtime folder its parent is a fixed name in /tmp
# that anyone could have made first, and files written into someone else's folder can be pointed
# anywhere, so a parent that isn't this user's own is refused.
make_state() {
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
        mkdir -m 700 "${STATE%/*}" 2>/dev/null
        if [ -L "${STATE%/*}" ] || [ "$(stat -c %u "${STATE%/*}" 2>/dev/null)" != "$(id -u)" ]; then
            return 1
        fi
        chmod 700 "${STATE%/*}" || return 1
    fi
    mkdir -p "$STATE" && chmod 700 "$STATE"
}

# Single-quoted for a shell, whatever it holds.
shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# ---------------------------------------------------------------------------------------------
# Talking to the notification server

BUS_DEST=org.freedesktop.Notifications
BUS_PATH=/org/freedesktop/Notifications

# notify REPLACES_ID URGENCY SOUND SUMMARY BODY [WINDOW]: sends a notification and prints its id.
# URGENCY is 0-2; SOUND is a sound theme name, or empty for none; WINDOW is the process of the
# terminal the session is in, when that isn't above this one.
notify() {
    notify_replace=$1 notify_urgency=$2 notify_sound=$3 notify_summary=$4 notify_body=$5
    notify_window=${6:-}
    is_number "$notify_replace" || notify_replace=0
    if have busctl; then
        if [ -n "$notify_sound" ]; then
            set -- urgency y "$notify_urgency" sound-name s "$notify_sound"
        else
            set -- urgency y "$notify_urgency" suppress-sound b true
        fi
        if is_number "$notify_window"; then
            set -- 3 "$@" sender-pid x "$notify_window"
        else
            set -- 2 "$@"
        fi
        busctl --user --timeout=5 -- call "$BUS_DEST" "$BUS_PATH" "$BUS_DEST" Notify 'susssasa{sv}i' \
            "$notify_app" "$notify_replace" utilities-terminal "$notify_summary" "$notify_body" \
            0 "$@" -1 2>/dev/null | sed -n 's/^u //p'
    elif have notify-send; then
        set -- -a "$notify_app" -i utilities-terminal -p
        case $notify_urgency in
            2) set -- "$@" -u critical ;;
            0) set -- "$@" -u low ;;
        esac
        if [ "$notify_replace" -gt 0 ]; then
            set -- "$@" -r "$notify_replace"
        fi
        if [ -n "$notify_sound" ]; then
            set -- "$@" -h "string:sound-name:$notify_sound"
        else
            set -- "$@" -h boolean:suppress-sound:true
        fi
        if is_number "$notify_window"; then
            set -- "$@" -h "int:sender-pid:$notify_window"
        fi
        notify-send "$@" -- "$notify_summary" "$notify_body" 2>/dev/null
    fi
}

close_notification() {
    if is_number "$1" && have busctl; then
        busctl --user --timeout=5 -- call "$BUS_DEST" "$BUS_PATH" "$BUS_DEST" CloseNotification u "$1" \
            >/dev/null 2>&1
    fi
}

# ---------------------------------------------------------------------------------------------
# The hooks

# The agent's own process: the nearest one above this hook that is called what the agent is.
# Tools that manage agent sessions from outside the process tree can set AGENT_NOTIFY_PID to the
# agent's PID directly, skipping the ancestry walk.
#
# If a second ancestor with the same name is found above the first, this hook is running inside a
# subagent spawned by a parent session. Only the top-level session leaves a note; subagents don't.
# One straight above another is the same session restarting itself, as Gemini CLI does.
agent_pid() {
    if is_number "${AGENT_NOTIFY_PID:-}"; then
        printf '%s' "$AGENT_NOTIFY_PID"
        return 0
    fi
    walk_pid=$PPID
    found=
    below=
    while [ "${walk_pid:-0}" -gt 1 ]; do
        if is_agent "$1" "$walk_pid"; then
            if [ -z "$found" ]; then
                found=$walk_pid
            elif [ -z "$below" ]; then
                # A second ancestor with this name: we are a subagent, not the top-level session.
                return 1
            fi
            below=$walk_pid
        else
            below=
        fi
        # The parent is the second field after the command name, which can itself hold spaces.
        walk_pid=$(sed 's/.*) //' "/proc/$walk_pid/stat" 2>/dev/null | cut -d' ' -f2)
    done
    [ -n "$found" ] && printf '%s' "$found" && return 0
    return 1
}

# Whether process `$2` is agent `$1`: called that, an interpreter (node, python) running a script
# called that, as Gemini CLI is, or running a versioned copy of it from a terminal. Claude runs a
# background session straight from its versions folder, so the process is named after the
# version. The host above it, which keeps the session's terminal, has none of its own and isn't
# counted, or the session would look like a subagent.
is_agent() {
    [ "$(cat "/proc/$2/comm" 2>/dev/null)" = "$1" ] && return 0
    agent_script=$(tr '\0' '\n' <"/proc/$2/cmdline" 2>/dev/null | sed -n 2p)
    [ "${agent_script##*/}" = "$1" ] && return 0
    case $(readlink "/proc/$2/exe" 2>/dev/null) in
    */"$1"/versions/*) case $(readlink "/proc/$2/fd/0" 2>/dev/null) in /dev/pts/*) return 0 ;; esac ;;
    esac
    return 1
}

# What the agent is working on, in a few words, from the hook's JSON in $payload: the title the
# agent has given the session where it keeps one, or else how the prompt begins, from the hook or
# the transcript. Nothing if neither says.
task() {
    task_file=$(printf '%s' "$payload" | jq -r '.transcript_path // .transcriptPath // empty' 2>/dev/null)
    task_title=
    if [ -r "$task_file" ]; then
        # Titles are written again as a session goes on, so the newest is near the end.
        task_title=$(tail -c 400000 "$task_file" 2>/dev/null |
            grep -E '"type": ?"(ai|custom)-title"' | tail -n 1 |
            jq -r '.customTitle // .aiTitle // .title // empty' 2>/dev/null)
    fi
    if [ -z "$task_title" ]; then
        task_title=$(printf '%s' "$payload" | jq -r '.prompt // empty' 2>/dev/null)
    fi
    if [ -z "$task_title" ] && [ -r "$task_file" ]; then
        # Antigravity sends no prompt, but its transcript keeps each one in a USER_REQUEST tag.
        task_title=$(tail -c 400000 "$task_file" 2>/dev/null |
            grep '"type": \{0,1\}"USER_INPUT"' | tail -n 1 |
            jq -r '.content // "" | capture("<USER_REQUEST>\\s*(?<r>[^<]*)").r // "" | gsub("\\s+$"; "")' 2>/dev/null)
    fi
    printf '%s' "$task_title" | tr '\n' ' ' | tr -d '\000-\037\177' | cut -c1-60
}

# job_id AGENT PID: the background session Claude Code runs as process PID, from the entry it
# keeps for each running session. A resumed session has a new session ID but keeps its job's.
job_id() {
    [ "$1" = claude ] || return 1
    job_id=$(jq -r '.jobId // empty' "$HOME/.claude/sessions/$2.json" 2>/dev/null |
        tr -cd 'A-Za-z0-9_-')
    [ -n "$job_id" ] && printf '%s' "$job_id"
}

# job_record AGENT PID: the record Claude Code keeps of that background session: its name, whether
# it is busy, and the subagents it has running. Nothing for any other session.
job_record() {
    job_record_id=$(job_id "$1" "$2") || return 1
    job_file=$HOME/.claude/jobs/$job_record_id/state.json
    [ -r "$job_file" ] && printf '%s' "$job_file"
}

# working_note AGENT active|idle [new]: writes the note that tells the desktop what the agent is
# doing, only where a desktop has made the folder for them, and with "new" only if there's no note
# yet. The first line names the agent; the second says "idle", or nothing while it works; each line
# after is a subagent it has running, by its task. An agent idle with subagents still running is
# working through them. The note stays while the session is open; the desktop cleans up dead PIDs.
#
# The whole note is written each time from what the agent records, so nothing here keeps count.
working_note() {
    note_dir=${XDG_RUNTIME_DIR:-}/slipstream/working
    if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$note_dir" ]; then
        return 0
    fi
    note_pid=$(agent_pid "$1") || return 0
    note_file=$note_dir/$note_pid
    if [ "${3:-}" = new ] && [ -e "$note_file" ]; then
        return 0
    fi
    note_name='' note_helpers=''
    if note_job=$(job_record "$1" "$note_pid"); then
        note_name=$(jq -r '.name // "" | gsub("\\s+"; " ")' "$note_job" 2>/dev/null)
        note_helpers=$(jq -r '.fan[]? | select(.kind == "agent" and .doneAt == null)
            | .label // "" | gsub("\\s+"; " ")' "$note_job" 2>/dev/null |
            tr -d '\000-\011\013-\037\177' | cut -c1-60 | sed '/^ *$/d' | head -n 8)
    elif ! printf '%s' "$payload" | jq -e '.agent_id' >/dev/null 2>&1; then
        # A subagent's hooks name its own task, not the session's.
        note_name=$(task)
    fi
    note_name=$(printf '%s' "$note_name" | tr -d '\000-\037\177' | cut -c1-60)
    if [ -n "$note_name" ]; then
        note_name="$(agent_label "$1"): $note_name"
    else
        note_name=$(head -n 1 "$note_file" 2>/dev/null)
    fi
    if [ -z "$note_name" ]; then
        note_name=$(printf '%s' "$payload" | jq -r '.cwd // .workspacePaths[0] // empty' 2>/dev/null)
        note_name="$(agent_label "$1")${note_name:+: ${note_name##*/}}"
    fi
    note_status=
    if [ "$2" = idle ] && [ -z "$note_helpers" ]; then
        note_status=idle
    fi
    # Written whole and moved into place, so the desktop never reads half a note, and a subagent's
    # hook running alongside writes its own whole note rather than into this one.
    printf '%s\n%s\n%s' "$note_name" "$note_status" "${note_helpers:+$note_helpers
}" >"$note_dir/.$note_pid.$$" && mv -f "$note_dir/.$note_pid.$$" "$note_file"
}

# Reads a value from the hook's JSON, by jq path, as a single line of at most 160 characters, with
# the few characters notification markup cares about escaped. A list is joined with spaces.
field() {
    printf '%s' "$payload" | jq -r "($1)"' // ""
        | if type == "array" then map(tostring) | join(" ") else tostring end
        | gsub("\\s+"; " ") | .[0:160]
        | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;")' 2>/dev/null
}

hook() {
    agent=$1 event=$2
    # Whatever happens, the agent sees nothing: no output, and success. Anything on stdout could
    # end up in the model's context, and some exit codes block the agent.
    exec >/dev/null 2>&1
    payload=$(cat)
    # Run after every tool, so it does as little as it can.
    have jq || exit 0
    if [ "$event" = session_start ]; then
        # A new session has opened: leave an idle note if there isn't one yet, named for the agent
        # and its folder until a task gives it a better name.
        working_note "$agent" idle new
        exit 0
    fi
    if [ "$event" = working ]; then
        working_note "$agent" active
        exit 0
    fi
    # Not what an agent sends: nothing to say.
    printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 || exit 0

    session=$(field '.session_id // .conversationId' | tr -cd 'A-Za-z0-9_-' | cut -c1-80)
    [ -n "$session" ] || session=default
    make_state || exit 0
    started_file=$STATE/$agent-$session.started
    id_file=$STATE/$agent-$session.id
    notify_app=$(agent_name "$agent")

    long=$(conf long-task-secs 120)
    is_number "$long" || long=120
    now=$(uptime_secs)
    elapsed=
    if [ -r "$started_file" ]; then
        read -r started <"$started_file"
        if is_number "$started"; then
            elapsed=$((now - started))
        fi
    fi
    previous=
    if [ -r "$id_file" ]; then
        read -r previous <"$id_file"
    fi

    project=$(field '.cwd // .workspacePaths[0]')
    project=${project##*/}

    # Antigravity says nothing when a prompt arrives, only before each call to its model: the
    # first of those since the last finish is the start.
    if [ "$event" = step ]; then
        if [ -r "$started_file" ]; then
            working_note "$agent" active
            exit 0
        fi
        event=start
    fi

    case $event in
        start)
            printf '%s\n' "$now" >"$started_file"
            working_note "$agent" active
            # You're back and typing: the last word from this session has done its job.
            if [ -n "$previous" ]; then
                close_notification "$previous"
                rm -f "$id_file"
            fi
            exit 0
            ;;
        finish)
            rm -f "$started_file"
            working_note "$agent" idle
            summary="$notify_app finished"
            detail=$(field .last_assistant_message)
            [ -n "$detail" ] || detail=$(field .prompt_response)
            sound=$(conf sound-finished complete)
            ;;
        attention)
            working_note "$agent" idle
            summary="$notify_app needs you"
            detail=$(field .message)
            if [ -z "$detail" ]; then
                tool=$(field .tool_name)
                wants=$(field '.tool_input.command?')
                if [ -n "$wants" ]; then
                    detail="Wants to run: $wants"
                elif [ -n "$tool" ]; then
                    detail="Waiting to use $tool"
                else
                    detail="Waiting for your answer"
                fi
            fi
            sound=$(conf sound-attention window-attention)
            ;;
        *) exit 0 ;;
    esac

    line=$project
    if [ -n "$elapsed" ]; then
        line="${line:+$line · }$(duration "$elapsed")"
    fi
    body=$line
    if [ -n "$detail" ]; then
        body="${body:+$body
}$detail"
    fi

    # Only a long task is worth a sound: a short one finished while you watched. And only one
    # waiting on you is worth the screen. A finish can wait until you're back, so it isn't critical
    # and a desktop that has faded to its wallpaper stays there.
    if [ -n "$elapsed" ] && [ "$elapsed" -ge "$long" ]; then
        if [ "$event" = finish ]; then
            urgency=1
        else
            urgency=2
        fi
    else
        urgency=1 sound=
    fi
    # A session kept running in the background has no window above it: name the terminal attached
    # to it, if that is still the process `keep` left there.
    window=
    window_file=$STATE/$agent-${session%%-*}.window
    if [ -r "$window_file" ]; then
        read -r window <"$window_file"
        if ! is_number "$window" || [ "$(cat "/proc/$window/comm" 2>/dev/null)" != agent-notify ]; then
            window=
        fi
    fi
    id=$(notify "$previous" "$urgency" "$sound" "$summary" "$body" "$window")
    if is_number "$id"; then
        printf '%s\n' "$id" >"$id_file"
    fi
    exit 0
}

# ---------------------------------------------------------------------------------------------
# Keeping a session running

# Claude Code's subcommands, which aren't sessions and run as they are.
CLAUDE_COMMANDS="agents attach auth auto-mode doctor gateway import install kill logs mcp plugin
plugins purge respawn rm setup-token stop ultrareview update upgrade"

# keep_attach AGENT ID: attaches this terminal to a background session, reopening it if it has
# stopped. This process stays under the window's shell while it does, so it is left as the
# session's window for its notifications, and as the note that attaches the window again at the
# next login: the layout record looks for notes under the window's shell, which the session isn't.
#
# Closing the window or logging out hangs this process up with it, and a session still working
# carries on.
# Leaving the session in the window (detaching, or quitting the agent view) stops it, as quitting
# the agent does anywhere else: its conversation is kept, and attaching opens it again.
keep_attach() {
    if make_state; then
        printf '%s\n' "$$" >"$STATE/$1-$2.window"
    fi
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && mkdir -p "$XDG_RUNTIME_DIR/slipstream/resume" 2>/dev/null; then
        printf '%s keep %s attach %s\n' "$(shell_quote "$self")" "$1" "$2" \
            >"$XDG_RUNTIME_DIR/slipstream/resume/$$"
    fi
    # Expanded now, while they are this function's: both are plain words, the agent's name and an
    # ID already checked to be letters and digits.
    # shellcheck disable=SC2064
    trap "keep_hung_up $1 $2" HUP TERM
    "$1" attach "$2"
    # A hung-up terminal can still be closing round us: only stop for one that's still there.
    if ! stty size >/dev/null 2>&1; then
        exit 0
    fi
    # Extra presses of the key that detached mustn't cut the stop short, or close the shell.
    trap '' INT
    "$1" stop "$2" >/dev/null 2>&1
    rm -f "$STATE/$1-$2.window" "${XDG_RUNTIME_DIR:-}/slipstream/resume/$$"
    exit 0
}

# keep_hung_up AGENT ID: the terminal has gone, and a session still working carries on. One with
# nothing under way would sit in memory with no terminal to reach it by, so it is stopped. Its
# conversation is kept, and attaching opens it again.
keep_hung_up() {
    if ! jq -e '.state == "working"' "$HOME/.claude/jobs/$2/state.json" >/dev/null 2>&1; then
        "$1" stop "$2" >/dev/null 2>&1
    fi
    exit 0
}

# keep AGENT [ARGS...]: starts a session in the background and attaches this terminal to it. Only
# Claude Code runs one; any other agent, and anything that isn't an interactive session (print
# mode, a subcommand, no terminal), runs as it is.
keep() {
    keep_agent=$1
    shift
    if [ "$keep_agent" != claude ] || [ ! -t 0 ] || [ ! -t 1 ]; then
        exec "$keep_agent" "$@"
    fi
    # The ID goes into the note run again at the next login, so only one shaped like an ID is kept
    # there; anything else is claude's to answer.
    if [ "${1:-}" = attach ] && [ $# -eq 2 ]; then
        case $2 in
            '' | *[!0-9A-Za-z_-]*) ;;
            *) keep_attach claude "$2" ;;
        esac
    fi
    for keep_word in $CLAUDE_COMMANDS; do
        if [ "${1:-}" = "$keep_word" ]; then
            exec claude "$@"
        fi
    done
    for keep_arg; do
        case $keep_arg in
            -p | --print | --bg | --background | -h | --help | -v | --version) exec claude "$@" ;;
        esac
    done
    # Claude won't start a background session in a folder it hasn't been trusted in yet: then it
    # runs as usual, and asks.
    keep_id=$(claude --bg "$@" </dev/null 2>/dev/null |
        sed -n 's/^ *claude attach \([0-9A-Za-z_-]\{1,80\}\) .*/\1/p' | head -n 1)
    if [ -z "$keep_id" ]; then
        exec claude "$@"
    fi
    keep_attach claude "$keep_id"
}

# ---------------------------------------------------------------------------------------------
# Setup

# The command a hook runs, quoted for the shell each agent runs hooks under.
hook_command() {
    printf '%s hook %s' "$(shell_quote "$self")" "$1"
}

# merge FILE JQ_PROGRAM [jq args...]: rewrites a JSON settings file through jq, atomically, keeping
# a one-time backup. A missing file starts as {}; an unreadable one is left alone.
merge() {
    merge_file=$1
    shift
    mkdir -p "$(dirname "$merge_file")"
    if [ -e "$merge_file" ]; then
        if ! jq -e . "$merge_file" >/dev/null 2>&1; then
            echo "  $merge_file isn't valid JSON; leaving it alone" >&2
            return 1
        fi
        if [ ! -e "$merge_file.agent-notify.bak" ]; then
            cp -p "$merge_file" "$merge_file.agent-notify.bak"
        fi
        merge_input=$merge_file
    else
        merge_input=/dev/null
    fi
    merge_tmp=$(mktemp "$merge_file.XXXXXX") || return 1
    if { [ "$merge_input" = /dev/null ] && echo '{}' || cat "$merge_input"; } |
        jq --indent 2 "$@" >"$merge_tmp" && [ -s "$merge_tmp" ]; then
        if [ -e "$merge_file" ]; then
            chmod --reference="$merge_file" "$merge_tmp" 2>/dev/null
        fi
        mv "$merge_tmp" "$merge_file"
    else
        rm -f "$merge_tmp"
        echo "  couldn't update $merge_file" >&2
        return 1
    fi
}

# Takes out every hook group whose commands are ours, then (unless removing) adds `$groups`, an
# object of event name to one group each. Events left empty are dropped.
# shellcheck disable=SC2016 # jq program, not shell
HOOKS_JQ='
    def ours: any(.hooks[]?; (.command? // "") | contains("agent-notify") and contains(" hook "));
    .hooks = ((.hooks // {}) | with_entries(.value |= map(select(ours | not))))
    | reduce ($groups | to_entries[]) as $e (.;
        .hooks[$e.key] += (if ($e.value | type) == "array" then $e.value else [$e.value] end))
    | .hooks |= with_entries(select(.value | length > 0))
    | if .hooks == {} then del(.hooks) else . end'

setup_claude() {
    groups=$(jq -n --arg ss "$(hook_command 'claude session_start')" \
        --arg s "$(hook_command 'claude start')" \
        --arg f "$(hook_command 'claude finish')" --arg a "$(hook_command 'claude attention')" \
        --arg w "$(hook_command 'claude working')" '{
        SessionStart: {hooks: [{type: "command", command: $ss, timeout: 10}]},
        UserPromptSubmit: {hooks: [{type: "command", command: $s, timeout: 10}]},
        Stop: {hooks: [{type: "command", command: $f, timeout: 10}]},
        PostToolUse: {hooks: [{type: "command", command: $w, timeout: 5}]},
        Notification: {matcher: "permission_prompt|elicitation_dialog",
                       hooks: [{type: "command", command: $a, timeout: 10}]}}')
    if [ "$remove" = 1 ]; then
        groups='{}'
    fi
    merge "$HOME/.claude/settings.json" --argjson groups "$groups" "$HOOKS_JQ"
}

setup_gemini() {
    groups=$(jq -n --arg ss "$(hook_command 'gemini session_start')" \
        --arg s "$(hook_command 'gemini start')" --arg w "$(hook_command 'gemini working')" \
        --arg f "$(hook_command 'gemini finish')" --arg a "$(hook_command 'gemini attention')" '{
        SessionStart: {hooks: [{type: "command", name: "agent-notify-session", command: $ss, timeout: 5000}]},
        AfterTool: {hooks: [{type: "command", name: "agent-notify-working", command: $w, timeout: 5000}]},
        BeforeAgent: {hooks: [{type: "command", name: "agent-notify-start", command: $s, timeout: 5000}]},
        AfterAgent: {hooks: [{type: "command", name: "agent-notify-finish", command: $f, timeout: 5000}]},
        Notification: {hooks: [{type: "command", name: "agent-notify-attention", command: $a, timeout: 5000}]}}')
    if [ "$remove" = 1 ]; then
        groups='{}'
    fi
    merge "$HOME/.gemini/settings.json" --argjson groups "$groups" "$HOOKS_JQ"
}

setup_codex() {
    groups=$(jq -n --arg ss "$(hook_command 'codex session_start')" \
        --arg s "$(hook_command 'codex start')" --arg w "$(hook_command 'codex working')" \
        --arg f "$(hook_command 'codex finish')" --arg a "$(hook_command 'codex attention')" '{
        SessionStart: {hooks: [{type: "command", command: $ss, timeout: 10}]},
        PostToolUse: {matcher: "*", hooks: [{type: "command", command: $w, timeout: 5}]},
        UserPromptSubmit: {hooks: [{type: "command", command: $s, timeout: 10}]},
        Stop: {hooks: [{type: "command", command: $f, timeout: 10}]},
        PermissionRequest: {matcher: "*", hooks: [{type: "command", command: $a, timeout: 10}]}}')
    if [ "$remove" = 1 ]; then
        groups='{}'
    fi
    merge "${CODEX_HOME:-$HOME/.codex}/hooks.json" --argjson groups "$groups" "$HOOKS_JQ" || return 1
    if [ "$remove" = 0 ]; then
        echo "  Codex runs new hooks only once you trust them: open /hooks in Codex."
    fi
}

# Antigravity's hooks file holds named hooks, so ours is one entry, put in or taken out whole. It
# has no event for a permission prompt, so it gets no attention hook.
setup_agy() {
    hooks=$(jq -n --arg ss "$(hook_command 'agy session_start')" \
        --arg st "$(hook_command 'agy step')" --arg w "$(hook_command 'agy working')" \
        --arg f "$(hook_command 'agy finish')" '{
        SessionStart: [{type: "command", command: $ss, timeout: 10}],
        PreInvocation: [{type: "command", command: $st, timeout: 10}],
        PostToolUse: [{matcher: "*", hooks: [{type: "command", command: $w, timeout: 5}]}],
        Stop: [{type: "command", command: $f, timeout: 10}]}')
    # shellcheck disable=SC2016 # jq program, not shell
    merge "$HOME/.gemini/config/hooks.json" --argjson hooks "$hooks" --argjson remove "$remove" \
        'if $remove == 1 then del(.["agent-notify"]) else .["agent-notify"] = $hooks end'
}

# Writes the config the first time, with the agents that are installed.
write_default_config() {
    [ -e "$CONFIG" ] && return 0
    detected=
    for candidate in $KNOWN_AGENTS; do
        if have "$candidate"; then
            detected="${detected:+$detected }$candidate"
        fi
    done
    mkdir -p "$(dirname "$CONFIG")"
    cat >"$CONFIG" <<EOF
# agent-notify. Run "agent-notify setup" after changing agents.

# The agents to wire up, any of: $KNOWN_AGENTS
agents = $detected

# A task that runs this long, in seconds, is announced with a sound, and as critical if it's waiting
# on you. Shorter ones get a quiet notification.
long-task-secs = 120

# Sound theme names (freedesktop sound naming), for the long tasks.
sound-finished = complete
sound-attention = window-attention
EOF
    echo "Wrote $CONFIG (agents: ${detected:-none found})"
}

setup() {
    remove=0
    if [ "${1:-}" = --remove ]; then
        remove=1
        shift
    fi
    have jq || {
        echo "agent-notify needs jq" >&2
        exit 1
    }
    write_default_config
    if [ $# -gt 0 ] && [ "$remove" = 0 ]; then
        for named in "$@"; do
            case " $KNOWN_AGENTS " in
                *" $named "*) ;;
                *)
                    echo "unknown agent: $named (known: $KNOWN_AGENTS)" >&2
                    exit 1
                    ;;
            esac
        done
        conf_tmp=$(mktemp "$CONFIG.XXXXXX") || exit 1
        if sed "s/^[[:space:]]*agents[[:space:]]*=.*/agents = $*/" "$CONFIG" >"$conf_tmp"; then
            mv "$conf_tmp" "$CONFIG"
        else
            rm -f "$conf_tmp"
        fi
    fi
    wanted=$(conf agents "")
    for agent in $KNOWN_AGENTS; do
        case " $wanted " in
            *" $agent "*) enable=1 ;;
            *) enable=0 ;;
        esac
        # Removing, or an agent no longer listed: take its hooks out if it has any.
        if [ "$remove" = 1 ] || [ "$enable" = 0 ]; then
            if wired "$agent"; then
                remove_was=$remove
                remove=1
                "setup_$agent" && echo "$(agent_name "$agent"): hooks removed"
                remove=$remove_was
            fi
        else
            if ! have "$agent"; then
                echo "$(agent_name "$agent"): not installed, wiring it anyway"
            fi
            "setup_$agent" && echo "$(agent_name "$agent"): hooks in place"
        fi
    done
}

# Where an agent's hooks live.
hooks_file() {
    case $1 in
        claude) printf '%s' "$HOME/.claude/settings.json" ;;
        gemini) printf '%s' "$HOME/.gemini/settings.json" ;;
        codex) printf '%s' "${CODEX_HOME:-$HOME/.codex}/hooks.json" ;;
        agy) printf '%s' "$HOME/.gemini/config/hooks.json" ;;
    esac
}

wired() {
    wired_file=$(hooks_file "$1")
    [ -r "$wired_file" ] && grep -q 'agent-notify.* hook ' "$wired_file"
}

status() {
    echo "config: $CONFIG"
    echo "agents: $(conf agents '(none)')"
    echo "long task: $(conf long-task-secs 120)s"
    for agent in $KNOWN_AGENTS; do
        installed=no
        have "$agent" && installed=yes
        hooked=no
        wired "$agent" && hooked=yes
        printf '  %-12s installed: %-3s  hooks: %s\n' "$(agent_name "$agent")" "$installed" "$hooked"
    done
    for tool in jq busctl notify-send; do
        printf '  %-12s %s\n' "$tool" "$(command -v "$tool" || echo missing)"
    done
    if have busctl; then
        server=$(busctl --user --timeout=3 -- call "$BUS_DEST" "$BUS_PATH" "$BUS_DEST" \
            GetServerInformation 2>/dev/null | cut -d'"' -f2)
        caps=$(busctl --user --timeout=3 -- call "$BUS_DEST" "$BUS_PATH" "$BUS_DEST" \
            GetCapabilities 2>/dev/null | tr -d '"' | cut -d' ' -f3-)
        echo "notification server: ${server:-none answering}${caps:+ ($caps)}"
    fi
    sessions
}

# terminal_of PID: the terminal that process is running in, by name and PID: the nearest process
# above it that isn't itself reading from one.
terminal_of() {
    terminal_pid=$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f2)
    while [ "${terminal_pid:-0}" -gt 1 ]; do
        case $(readlink "/proc/$terminal_pid/fd/0" 2>/dev/null) in
            /dev/pts/*) ;;
            *)
                printf '%s (PID %s)' "$(cat "/proc/$terminal_pid/comm" 2>/dev/null)" "$terminal_pid"
                return 0
                ;;
        esac
        terminal_pid=$(sed 's/.*) //' "/proc/$terminal_pid/stat" 2>/dev/null | cut -d' ' -f2)
    done
    return 1
}

# The sessions the desktop shows a trace for, and where each one is: the terminal it is in, or how
# to reach or stop one Claude Code keeps running with no terminal attached.
sessions() {
    sessions_dir=${XDG_RUNTIME_DIR:-}/slipstream/working
    [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$sessions_dir" ] || return 0
    echo "sessions on the desktop:"
    sessions_any=
    for sessions_note in "$sessions_dir"/*; do
        sessions_pid=${sessions_note##*/}
        is_number "$sessions_pid" && [ -d "/proc/$sessions_pid" ] || continue
        sessions_any=1
        sessions_agent=
        for agent in $KNOWN_AGENTS; do
            if is_agent "$agent" "$sessions_pid"; then
                sessions_agent=$agent
                break
            fi
        done
        sessions_state=working
        [ "$(sed -n 2p "$sessions_note")" = idle ] && sessions_state=idle
        printf '  %-8s %-7s %s\n' "$sessions_pid" "$sessions_state" "$(head -n 1 "$sessions_note")"
        if sessions_job=$(job_id "$sessions_agent" "$sessions_pid"); then
            sessions_window=
            read -r sessions_window 2>/dev/null <"$STATE/$sessions_agent-$sessions_job.window"
            if is_number "$sessions_window" &&
                [ "$(cat "/proc/$sessions_window/comm" 2>/dev/null)" = agent-notify ] &&
                sessions_where=$(terminal_of "$sessions_window"); then
                printf '           in %s\n' "$sessions_where"
            else
                printf '           no terminal: "claude attach %s" opens it, "claude stop %s" ends it\n' \
                    "$sessions_job" "$sessions_job"
            fi
        elif sessions_where=$(terminal_of "$sessions_pid"); then
            printf '           in %s\n' "$sessions_where"
        else
            printf '           no terminal\n'
        fi
    done
    [ -n "$sessions_any" ] || echo "  none"
}

sample() {
    notify_app="agent-notify"
    if [ "${1:-}" = --long ]; then
        notify "" 2 "$(conf sound-finished complete)" "Sample task finished" \
            "A long one: critical, with a sound" >/dev/null
    else
        notify "" 1 "" "Sample task finished" "A short one: quiet" >/dev/null
    fi
}

# ---------------------------------------------------------------------------------------------
# Usage limits
#
# How much of each agent's plan limits is used, for a desktop meter. `usage` prints JSON straight
# from a cache and refreshes the cache in the background once it's older than usage-refresh-secs.
# The numbers come from where the agents' own usage screens get them:
#
#   Claude Code  GET api.anthropic.com/api/oauth/usage with Claude Code's own login. The login is
#                only ever read. Renewing it would replace the refresh token and sign Claude Code
#                out, so an expired one waits for Claude Code to renew it.
#   Codex        account/rateLimits/read from `codex app-server`, which looks after its own login.
#   Antigravity  `agy -p /usage`, the CLI's own quota readout.
#
# None is a documented API: they're asked at most every few minutes, and a refusal keeps the
# last numbers on show with a note saying why they're old.

USAGE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/agent-notify/usage
USAGE_PROVIDERS="claude codex agy"
CLAUDE_CREDENTIALS=$HOME/.claude/.credentials.json

# The providers to report: agents in the config that usage can be read for.
usage_providers() {
    usage_wanted=$(conf agents "")
    for usage_p in $USAGE_PROVIDERS; do
        case " $usage_wanted " in
            *" $usage_p "*) ;;
            *) continue ;;
        esac
        case $usage_p in
            claude) [ -r "$CLAUDE_CREDENTIALS" ] || continue ;;
            codex) have codex || continue ;;
            agy) have agy || continue ;;
        esac
        printf '%s\n' "$usage_p"
    done
}

usage_refresh_secs() {
    usage_secs=$(conf usage-refresh-secs 300)
    is_number "$usage_secs" || usage_secs=300
    # The endpoints rate-limit; once a minute is the least anyone should wait.
    if [ "$usage_secs" -lt 60 ]; then
        usage_secs=60
    fi
    printf '%s' "$usage_secs"
}

# usage_due PROVIDER MIN_AGE: whether it was last asked at least MIN_AGE seconds ago, and isn't
# waiting out a rate limit.
usage_due() {
    due_now=$(date +%s)
    due_last=0 due_retry=0
    if [ -r "$USAGE_DIR/$1.asked" ]; then
        read -r due_last <"$USAGE_DIR/$1.asked"
    fi
    if [ -r "$USAGE_DIR/$1.retry" ]; then
        read -r due_retry <"$USAGE_DIR/$1.retry"
    fi
    is_number "$due_last" || due_last=0
    is_number "$due_retry" || due_retry=0
    [ $((due_now - due_last)) -ge "$2" ] && [ "$due_now" -ge "$due_retry" ]
}

# usage_write PROVIDER: the section on stdin replaces the provider's, if it's a JSON object.
usage_write() {
    write_tmp=$(mktemp "$USAGE_DIR/$1.XXXXXX") || return 1
    if cat >"$write_tmp" && jq -e 'type == "object"' "$write_tmp" >/dev/null 2>&1; then
        mv "$write_tmp" "$USAGE_DIR/$1.json"
    else
        rm -f "$write_tmp"
        return 1
    fi
}

# usage_keep PROVIDER NAME NOTE: the last numbers stay, marked stale, with NOTE saying why.
usage_keep() {
    keep_file=$USAGE_DIR/$1.json
    if [ -r "$keep_file" ]; then
        jq -c --arg note "$3" '.note = $note | .stale = true' "$keep_file"
    else
        jq -nc --arg name "$2" --arg note "$3" \
            '{name: $name, meters: [], note: $note, stale: true, updated: 0}'
    fi | usage_write "$1"
}

# Parses an ISO 8601 time with fractional seconds and any UTC offset to epoch seconds, and
# capitalises a word.
# shellcheck disable=SC2016 # jq program, not shell
USAGE_JQ_DEFS='
    def epoch:
        if type != "string" then null else
            capture("^(?<t>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<z>.*)$") as $m
            | ($m.t + "Z" | fromdateiso8601)
              - (if ($m.z | test("^[+-][0-9]{2}:[0-9]{2}$"))
                 then ($m.z[1:3] | tonumber) * 3600 + ($m.z[4:6] | tonumber) * 60
                      | if $m.z[0:1] == "-" then -. else . end
                 else 0 end)
        end;
    def title: (.[0:1] | ascii_upcase) + .[1:];'

# shellcheck disable=SC2016 # jq program, not shell
CLAUDE_JQ=$USAGE_JQ_DEFS'
    def meter($label; $percent; $resets):
        {label: $label, percent: ($percent // 0 | round), resets: ($resets | epoch)};
    {
        name: "Claude",
        detail: (if $plan == "" then null else ($plan | title) end),
        meters: (
            if (.limits | type) == "array" and (.limits | length) > 0 then
                [.limits[] | meter(
                    if .kind == "session" then "Session"
                    elif .kind == "weekly_all" then "Weekly"
                    elif .group == "weekly" then
                        "Weekly · " + ((.scope.model.display_name? // .scope.surface.display_name?
                                        // .scope.surface? // "other") | tostring)
                    else .kind | gsub("_"; " ") | title end;
                    .percent; .resets_at)]
            else
                [(["Session", .five_hour], ["Weekly", .seven_day])
                 | select(.[1] != null) | meter(.[0]; .[1].utilization; .[1].resets_at)]
            end),
        note: null,
        stale: false,
        updated: $now
    }'

usage_fetch_claude() {
    claude_now=$(date +%s)
    claude_expires=$(jq -r '(.claudeAiOauth.expiresAt // 0) / 1000 | floor' "$CLAUDE_CREDENTIALS" 2>/dev/null)
    claude_plan=$(jq -r '.claudeAiOauth.subscriptionType // ""' "$CLAUDE_CREDENTIALS" 2>/dev/null)
    if ! is_number "$claude_expires" || [ "$claude_expires" -le "$claude_now" ]; then
        usage_keep claude Claude "Login expired: Claude Code renews it when it next runs"
        return 1
    fi
    claude_body=$USAGE_DIR/claude.body claude_headers=$USAGE_DIR/claude.headers
    # The token goes to curl on stdin, never on its command line where any process listing shows it.
    claude_code=$(jq -r '"Authorization: Bearer " + .claudeAiOauth.accessToken' "$CLAUDE_CREDENTIALS" |
        curl -sS --max-time 20 -H @- -H 'anthropic-beta: oauth-2025-04-20' \
            -H 'Accept: application/json' -D "$claude_headers" -o "$claude_body" -w '%{http_code}' \
            https://api.anthropic.com/api/oauth/usage 2>/dev/null)
    claude_ok=1
    case $claude_code in
        200)
            if jq -c --arg plan "$claude_plan" --argjson now "$claude_now" "$CLAUDE_JQ" \
                "$claude_body" 2>/dev/null | usage_write claude; then
                claude_ok=0
            else
                usage_keep claude Claude "The usage reply wasn't in a shape agent-notify knows"
            fi
            ;;
        429)
            claude_wait=$(sed -n 's/^[Rr]etry-[Aa]fter:[[:space:]]*\([0-9]*\).*/\1/p' "$claude_headers" | head -n 1)
            is_number "$claude_wait" || claude_wait=0
            if [ "$claude_wait" -lt 300 ]; then
                claude_wait=300
            fi
            printf '%s\n' $((claude_now + claude_wait)) >"$USAGE_DIR/claude.retry"
            usage_keep claude Claude "Rate limited: asking again at $(date -d "@$((claude_now + claude_wait))" +%H:%M)"
            ;;
        401 | 403)
            usage_keep claude Claude "Login refused: Claude Code renews it when it next runs"
            ;;
        000 | '')
            usage_keep claude Claude "Couldn't reach Anthropic"
            ;;
        *)
            usage_keep claude Claude "Anthropic answered HTTP $claude_code"
            ;;
    esac
    rm -f "$claude_body" "$claude_headers"
    return "$claude_ok"
}

# shellcheck disable=SC2016 # jq program, not shell
CODEX_JQ=$USAGE_JQ_DEFS'
    def window:
        if . == null then "Limit"
        elif . % 1440 == 0 then (. / 1440) as $days
            | if $days == 1 then "Daily" elif $days == 7 then "Weekly"
              elif $days == 30 or $days == 31 then "Monthly" else "\($days)-day" end
        elif . % 60 == 0 then "\(. / 60)-hour"
        else "\(.)-minute" end;
    def meters($prefix):
        [(.primary, .secondary) | select(. != null)
         | {label: ($prefix + (.windowDurationMins | window)), percent: (.usedPercent // 0 | round),
            resets: .resetsAt}];
    .result as $r
    | $r.rateLimits as $main
    | {
        name: "Codex",
        detail: ($main.planType // "" | if . == "" then null else title end),
        meters: (($main | meters(""))
                 + ([($r.rateLimitsByLimitId // {}) | to_entries[] | select(.key != $main.limitId)
                     | .value | meters(((.limitName // .limitId) | tostring) + " · ")] | add // [])),
        note: (if $main.rateLimitReachedType != null then "Limit reached" else null end),
        stale: false,
        updated: $now
    }'

usage_fetch_codex() {
    codex_now=$(date +%s)
    codex_in=$USAGE_DIR/codex.in codex_out=$USAGE_DIR/codex.out
    rm -f "$codex_in" "$codex_out"
    mkfifo "$codex_in" || return 1
    # The app server answers on stdout while its stdin stays open; it's closed once the answer is in.
    timeout 30 codex -s read-only -a never app-server <"$codex_in" >"$codex_out" 2>/dev/null &
    codex_pid=$!
    exec 3>"$codex_in"
    printf '%s\n' \
        '{"id":0,"method":"initialize","params":{"clientInfo":{"name":"agent-notify","version":"1"}}}' \
        '{"method":"initialized"}' \
        '{"id":1,"method":"account/rateLimits/read"}' >&3
    codex_tries=0
    while [ "$codex_tries" -lt 60 ] && ! grep -q '"id":1[,}]' "$codex_out" 2>/dev/null; do
        sleep 0.5
        codex_tries=$((codex_tries + 1))
    done
    exec 3>&-
    kill "$codex_pid" 2>/dev/null
    wait "$codex_pid" 2>/dev/null
    codex_reply=$(jq -c 'select(.id == 1)' "$codex_out" 2>/dev/null | head -n 1)
    rm -f "$codex_in" "$codex_out"
    if [ -z "$codex_reply" ]; then
        usage_keep codex Codex "Codex didn't answer"
        return 1
    fi
    if printf '%s' "$codex_reply" | jq -e '.result.rateLimits' >/dev/null 2>&1 &&
        printf '%s' "$codex_reply" | jq -c --argjson now "$codex_now" "$CODEX_JQ" 2>/dev/null |
        usage_write codex; then
        return 0
    fi
    codex_error=$(printf '%s' "$codex_reply" | jq -r '.error.message // "no limits in its answer"' 2>/dev/null)
    usage_keep codex Codex "Codex: $codex_error"
    return 1
}

# Antigravity prints its quotas for /usage, one to a line, tab-separated: the models, the window
# and what is left of it, the percentage left, and when it resets. It is run from the usage folder
# because it keeps its conversations by folder, though this one leaves none.
# shellcheck disable=SC2016 # jq program, not shell
AGY_JQ=$USAGE_JQ_DEFS'
    [split("\n")[] | split("\t") | select(length == 4)
     | {models: (.[0] | sub(" [Mm]odels$"; "")), window: (.[1] | sub(" Limit Remaining$"; "")),
        left: (.[2] | rtrimstr("%") | tonumber? // null), resets: (.[3] | fromdateiso8601? // null)}
     | select(.left != null)
     | {label: "\(.window) · \(.models)", percent: (100 - .left | round), resets}] as $meters
    | if $meters == [] then empty
      else {name: "Antigravity", detail: null, meters: $meters, note: null, stale: false,
            updated: $now} end'

usage_fetch_agy() {
    agy_now=$(date +%s)
    agy_reply=$(cd "$USAGE_DIR" && timeout 60 agy -p /usage 2>/dev/null)
    if printf '%s' "$agy_reply" | jq -Rsc --argjson now "$agy_now" "$AGY_JQ" 2>/dev/null |
        usage_write agy; then
        return 0
    fi
    usage_keep agy Antigravity "Antigravity didn't say"
    return 1
}

# Notifies once per limit window as its use passes each level in usage-alerts.
usage_alerts() {
    alerts_file=$USAGE_DIR/alerts
    alerts_levels=$(conf usage-alerts "75 90 100")
    notify_app=$(agent_name "$1")
    alerts_now=$(date +%s)
    touch "$alerts_file"
    jq -r '.meters[] | [.label, .percent, (.resets // 0)] | @tsv' "$USAGE_DIR/$1.json" 2>/dev/null |
        while IFS='	' read -r alert_label alert_percent alert_resets; do
            is_number "$alert_percent" || continue
            # A window is known by its reset time, which wobbles by a second or so between answers.
            alert_done=$(awk -F '\t' -v key="$1|$alert_label" -v resets="$alert_resets" \
                '$1 == key && $2 - resets < 3600 && resets - $2 < 3600 { print $3 }' "$alerts_file")
            is_number "$alert_done" || alert_done=0
            alert_reached=0
            for alert_level in $alerts_levels; do
                if is_number "$alert_level" && [ "$alert_percent" -ge "$alert_level" ]; then
                    alert_reached=$alert_level
                fi
            done
            if [ "$alert_reached" -le "$alert_done" ]; then
                continue
            fi
            # One line per limit: its current window's.
            awk -F '\t' -v key="$1|$alert_label" '$1 != key' "$alerts_file" >"$alerts_file.new"
            printf '%s\t%s\t%s\n' "$1|$alert_label" "$alert_resets" "$alert_reached" >>"$alerts_file.new"
            mv "$alerts_file.new" "$alerts_file"
            alert_body=
            if is_number "$alert_resets" && [ "$alert_resets" -gt "$alerts_now" ]; then
                alert_body="Resets in $(duration $((alert_resets - alerts_now)))"
            fi
            if [ "$alert_reached" -ge 100 ]; then
                notify "" 2 "$(conf sound-attention window-attention)" \
                    "$notify_app · $alert_label: limit reached" "$alert_body" >/dev/null
            else
                notify "" 1 "" "$notify_app · $alert_label: $alert_percent% used" \
                    "$alert_body" >/dev/null
            fi
        done
}

# usage_refresh MIN_AGE: asks every provider last asked at least MIN_AGE seconds ago. One refresh
# runs at a time; another waits for it when WAIT is set, and otherwise leaves it to it.
usage_refresh() {
    exec 9>"$USAGE_DIR/lock"
    if [ -n "${WAIT:-}" ]; then
        flock -w 60 9 || return 0
    else
        flock -n 9 || return 0
    fi
    for refresh_p in $(usage_providers); do
        usage_due "$refresh_p" "$1" || continue
        date +%s >"$USAGE_DIR/$refresh_p.asked"
        if "usage_fetch_$refresh_p"; then
            rm -f "$USAGE_DIR/$refresh_p.retry"
            usage_alerts "$refresh_p"
        fi
    done
    exec 9>&-
}

usage_print() {
    print_now=$(date +%s)
    print_old=$(($(usage_refresh_secs) * 3))
    set --
    for print_p in $(usage_providers); do
        if [ -r "$USAGE_DIR/$print_p.json" ]; then
            set -- "$@" "$USAGE_DIR/$print_p.json"
        fi
    done
    if [ $# -eq 0 ]; then
        echo '{"sections":[]}'
        return
    fi
    # Numbers kept past three refreshes are old however they were kept.
    jq -cs --argjson now "$print_now" --argjson old "$print_old" \
        '{sections: map(.stale = (.stale or ($now - (.updated // 0)) > $old))}' "$@"
}

usage() {
    have jq || {
        echo "agent-notify usage needs jq" >&2
        exit 1
    }
    mkdir -p "$USAGE_DIR" && chmod 700 "$USAGE_DIR"
    refresh=$(usage_refresh_secs)
    case ${1:-} in
        --refresh)
            WAIT=1 usage_refresh 60
            usage_print
            ;;
        --background)
            usage_refresh "$refresh" >/dev/null 2>&1
            ;;
        '')
            cached=
            for cached_p in $(usage_providers); do
                if [ -r "$USAGE_DIR/$cached_p.json" ]; then
                    cached=1
                fi
            done
            if [ -z "$cached" ]; then
                # Nothing to show yet, so this once it's worth the wait.
                WAIT=1 usage_refresh "$refresh"
            else
                for due_p in $(usage_providers); do
                    if usage_due "$due_p" "$refresh"; then
                        # Detached, with nothing of the caller's open, so whoever runs `usage`
                        # gets its output and its exit straight away.
                        if have setsid; then
                            setsid -f "$self" usage --background </dev/null >/dev/null 2>&1
                        else
                            "$self" usage --background </dev/null >/dev/null 2>&1 &
                        fi
                        break
                    fi
                done
            fi
            usage_print
            ;;
        *)
            echo "usage: agent-notify usage [--refresh]" >&2
            exit 1
            ;;
    esac
}

