# The path hooks call: the copy on PATH if there is one, so the project can move.
self=$(command -v agent-notify 2>/dev/null || true)
case $self in
    /*) ;;
    *) self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
esac

case ${1:-} in
    hook)
        [ $# -ge 3 ] || exit 0
        hook "$2" "$3"
        ;;
    setup)
        shift
        setup "$@"
        ;;
    status) status ;;
    usage)
        shift
        usage "$@"
        ;;
    test)
        shift
        sample "$@"
        ;;
    keep)
        [ $# -ge 2 ] || exec sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
        shift
        keep "$@"
        ;;
    *)
        sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
        [ $# -eq 0 ]
        ;;
esac
